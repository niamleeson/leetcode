{"id":217,"title":"Contains Duplicate","topic":"Arrays & Hashing","difficulty":"Easy","description":"Given an integer array nums, return true if any value appears at least twice in the array, and return false if every element is distinct.","examples":[{"name":"Example","input":[[1,2,3,1]],"expected":true},{"name":"Edge case","input":[[1,2,3]],"expected":false}],"starter":"def containsDuplicate(nums: list[int]) -> bool:\n    pass\n","parameters":[{"name":"nums","type":"list[int]"}],"interfaces":[{"kind":"function","name":"containsDuplicate","parameters":[{"name":"nums","type":"list[int]"}],"signature":"def containsDuplicate(nums: list[int]) -> bool:","returnType":"bool"}],"fixtures":[{"name":"Example","entry":"containsDuplicate","params":["nums"],"args":[[1,2,3,1]],"expected":true},{"entry":"containsDuplicate","params":["nums"],"args":[[1,2,3]],"expected":false,"name":"Edge case"},{"name":"Practice check: Singleton has no duplicate","entry":"containsDuplicate","params":["nums"],"args":[[1]],"expected":false},{"name":"Practice check: Duplicate zero","entry":"containsDuplicate","params":["nums"],"args":[[0,0]],"expected":true},{"name":"Practice check: Nonadjacent negative duplicate","entry":"containsDuplicate","params":["nums"],"args":[[-2,1,-2]],"expected":true},{"name":"Practice check: Descending unique values","entry":"containsDuplicate","params":["nums"],"args":[[5,4,3,2,1]],"expected":false},{"name":"Practice check: Duplicate at the beginning","entry":"containsDuplicate","params":["nums"],"args":[[1,1,2,3]],"expected":true}],"validation":{"kind":"practice-cases","count":7,"adversarialCount":5}}
