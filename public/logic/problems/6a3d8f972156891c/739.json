{"id":739,"title":"Daily Temperatures","topic":"Stack","difficulty":"Medium","description":"Given an array of integers temperatures, return an array answer such that answer[i] is the number of days you have to wait after the ith day to get a warmer temperature. If there is no future day with a warmer temperature, answer[i] = 0.","examples":[{"name":"Example","input":[[73,74,75,71,69,72,76,73]],"expected":[1,1,4,2,1,1,0,0]},{"name":"Edge case","input":[[30,30,20]],"expected":[0,0,0]}],"starter":"def dailyTemperatures(temperatures):\n    pass\n","parameters":[{"name":"temperatures"}],"interfaces":[{"kind":"function","name":"dailyTemperatures","parameters":[{"name":"temperatures"}],"signature":"def dailyTemperatures(temperatures):"}],"fixtures":[{"name":"Example","entry":"dailyTemperatures","params":["temperatures"],"args":[[73,74,75,71,69,72,76,73]],"expected":[1,1,4,2,1,1,0,0]},{"entry":"dailyTemperatures","params":["temperatures"],"args":[[30,30,20]],"expected":[0,0,0],"name":"Edge case"},{"name":"Practice check: Equal temperatures are not warmer","entry":"dailyTemperatures","params":["temperatures"],"args":[[70,70,71]],"expected":[2,1,0]},{"name":"Practice check: No future warmer day keeps zero","entry":"dailyTemperatures","params":["temperatures"],"args":[[75,74,73]],"expected":[0,0,0]},{"name":"Practice check: The last day has no future day","entry":"dailyTemperatures","params":["temperatures"],"args":[[70]],"expected":[0]},{"name":"Practice check: One warmer day resolves several pending indices","entry":"dailyTemperatures","params":["temperatures"],"args":[[75,70,65,80]],"expected":[3,2,1,0]}],"validation":{"kind":"practice-cases","count":6,"adversarialCount":4}}
