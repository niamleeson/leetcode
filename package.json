{
  "name": "leetcode-trainer",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "ollama serve & node server.mjs & vite",
    "dev:vite": "vite",
    "dev:server": "node server.mjs",
    "build": "node tools/walkthroughs/check-artifacts.cjs && node tools/walkthroughs/check-python-artifacts.cjs && node tools/solutions/generate.cjs && node tools/catalog/check-catalog.cjs && node tools/logic/generate.cjs --check && node tools/logic/generate-javascript-adapter.cjs --check && node tools/logic/generate-guided.cjs --check-artifacts && node tools/logic/check-guided-coverage.cjs && tsc -b && vite build",
    "preview": "vite preview",
    "hackerrank:test": "vitest run --config vitest.hackerrank.config.ts",
    "walkthroughs:generate": "node tools/walkthroughs/verify.cjs --write && node tools/walkthroughs/verify-python.cjs --write",
    "walkthroughs:python:generate": "node tools/walkthroughs/verify-python.cjs --write",
    "walkthroughs:python:test": "python3 -B -m unittest discover -s tools/walkthroughs -p python_runtime_test.py",
    "walkthroughs:verify": "npm run walkthroughs:python:test && node --test tools/walkthroughs/runtime.test.cjs && node tools/walkthroughs/verify.cjs && node tools/walkthroughs/check-artifacts.cjs && node tools/walkthroughs/verify-python.cjs && node tools/walkthroughs/check-python-artifacts.cjs",
    "walkthroughs:test": "vitest run --config vitest.walkthrough.config.ts",
    "walkthroughs:audit": "node tools/walkthroughs/audit-recordings.cjs && node tools/walkthroughs/debugger-audit.cjs",
    "solutions:generate": "node tools/solutions/generate.cjs --write",
    "catalog:check": "node tools/catalog/check-catalog.cjs",
    "catalog:test": "vitest run --config vitest.catalog.config.ts",
    "logic:test": "vitest run --config vitest.logic.config.ts",
    "logic:data": "node tools/logic/generate.cjs --check && python3 -B tools/logic/data.test.py",
    "logic:verify": "node tools/logic/verify-runtime.mjs",
    "logic:guided:check": "node tools/logic/generate-curriculum.cjs --check && node tools/logic/generate-guided.cjs --check-artifacts && node tools/logic/check-guided-coverage.cjs",
    "logic:guided:verify": "node tools/logic/generate-guided.cjs --check && node tools/logic/verify-guided-javascript.cjs",
    "logic:guided:test": "python3 -B tools/logic/guided.test.py && node --test tools/logic/verify-guided-javascript.test.cjs tools/logic/curriculum.test.cjs tools/logic/check-guided-coverage.test.cjs tools/logic/generate-guided-javascript.test.cjs",
    "logic:javascript:verify": "node tools/logic/generate-javascript-adapter.cjs --check && node tools/logic/verify-javascript-runtime.cjs"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "^0.18.0",
    "@types/prismjs": "^1.26.6",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "katex": "^0.19.1",
    "mermaid": "^11.13.0",
    "prismjs": "^1.30.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.13.1",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@babel/generator": "^7.29.1",
    "@babel/parser": "^7.29.0",
    "@babel/traverse": "^7.29.0",
    "@babel/types": "^7.29.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "jsdom": "^29.0.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.6.3",
    "vite": "^6.0.3",
    "vitest": "^4.1.0"
  },
  "overrides": {
    "hast-util-raw": "9.0.4"
  }
}
