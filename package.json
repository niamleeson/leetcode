{
  "name": "leetcode-trainer",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "ollama serve & node server.mjs & vite",
    "dev:vite": "vite",
    "dev:server": "node server.mjs",
    "build": "node tools/walkthroughs/check-artifacts.cjs && tsc -b && vite build",
    "preview": "vite preview",
    "walkthroughs:generate": "node tools/walkthroughs/verify.cjs --write",
    "walkthroughs:verify": "node --test tools/walkthroughs/runtime.test.cjs && node tools/walkthroughs/verify.cjs && node tools/walkthroughs/check-artifacts.cjs",
    "walkthroughs:test": "vitest run --config vitest.walkthrough.config.ts"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "^0.18.0",
    "@types/prismjs": "^1.26.6",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "mermaid": "^11.13.0",
    "prismjs": "^1.30.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.13.1",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "jsdom": "^29.0.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.6.3",
    "vite": "^6.0.3",
    "vitest": "^4.1.0",
    "@babel/parser": "^7.29.0",
    "@babel/traverse": "^7.29.0",
    "@babel/generator": "^7.29.1",
    "@babel/types": "^7.29.0"
  }
}
