{"id":69,"title":"Sqrt(x)","topic":"Binary Search","code":"var mySqrt = function(x) {\n    // Generalized form: minimize k s.t. k*k > x, return k - 1\n    let lo = 0;\n    let hi = x + 1; // right = x + 1 to handle x = 0 and x = 1\n\n    while (lo < hi) {\n        const mid = Math.floor((lo + hi) / 2);\n\n        if (mid * mid > x) {\n            // mid satisfies the condition — could be the answer\n            hi = mid;\n        } else {\n            // mid doesn't satisfy — answer is to the right\n            lo = mid + 1;\n        }\n    }\n\n    // lo is the first k where k² > x, so lo - 1 is floor(sqrt(x))\n    return lo - 1;\n};","sourceHash":"7be9899d1da6e025ab72351cb57751aed732e516d604de95738f082f429bb133","generatorHash":"b66120ae1d9d0cfc0bba45cf6f5673ac49a7d0cba8100ee7e720869b46fddc24","fixtureHash":"f0f4887ebb8a3851dbbcd5a25e94bfbafc6af2b187c3b7d8a38317653b151a89","indexing":{},"examples":[{"name":"Example","input":[8],"expected":2,"result":2,"steps":[{"site":8,"line":1,"lines":[1],"start":13,"end":563,"kind":"call","label":"mySqrt","state":{"x":8},"input":{"x":8},"heap":{},"value":{"$scalar":"undefined"},"stack":["mySqrt"]},{"site":0,"line":3,"lines":[3],"start":94,"end":105,"kind":"statement","label":"let lo = 0;","state":{"x":8,"lo":0},"input":{"x":8},"heap":{},"value":{"$scalar":"undefined"},"stack":["mySqrt"]},{"site":1,"line":4,"lines":[4],"start":110,"end":125,"kind":"statement","label":"let hi = x + 1;","state":{"x":8,"lo":0,"hi":9},"input":{"x":8},"heap":{},"value":{"$scalar":"undefined"},"stack":["mySqrt"]},{"site":6,"line":6,"lines":[6],"start":181,"end":188,"kind":"check","label":"lo < hi","state":{"x":8,"lo":0,"hi":9},"input":{"x":8},"heap":{},"value":true,"stack":["mySqrt"]},{"site":2,"line":7,"lines":[7],"start":200,"end":238,"kind":"statement","label":"const mid = Math.floor((lo + hi) / 2);","state":{"mid":4,"x":8,"lo":0,"hi":9},"input":{"x":8},"heap":{},"value":{"$scalar":"undefined"},"stack":["mySqrt"]},{"site":5,"line":9,"lines":[9],"st