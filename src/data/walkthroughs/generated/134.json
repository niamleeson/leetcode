{"id":134,"title":"Gas Station","topic":"Greedy","code":"var canCompleteCircuit = function(gas, cost) {\n    // If we don't have enough total gas, no solution exists\n    const totalGas  = gas.reduce((sum, g) => sum + g, 0);\n    const totalCost = cost.reduce((sum, c) => sum + c, 0);\n\n    if (totalGas < totalCost) {\n        return -1;\n    }\n\n    // Since a solution is guaranteed to exist, greedily find the start station.\n    // \"tank\" tracks our running fuel surplus from the current candidate start\n    let tank  = 0;\n    let start = 0;\n\n    for (let i = 0; i < gas.length; i++) {\n        const netGain = gas[i] - cost[i]; // fuel gained minus fuel spent at station i\n        tank += netGain;\n\n        if (tank < 0) {\n            // Cannot reach station i+1 starting from \"start\".\n            // Any station between \"start\" and i would also fail (they'd start with\n            // even less surplus), so jump ahead to i+1 as the new candidate.\n            tank  = 0;\n            start = i + 1;\n        }\n    }\n\n    return start;\n};","sourceHash":"6b14fcdab9c3e7c2437b0388428fdf89cc2a9b1bbe99d7a98ab7e11d7199de25","generatorHash":"b66120ae1d9d0cfc0bba45cf6f5673ac49a7d0cba8100ee7e720869b46fddc24","fixtureHash":"a60f8b961f7e807c82d17e9a606d2130694171b567b83edc274c73f15bfa5105","indexing":{"gas":{"indices":["i"],"cells":[]},"cost":{"indices":["i"],"cells":[]}},"examples":[{"name":"Example","input":[[1,2,3,4,5],[3,4,5,1,2]],"expected":3,"result":3,"steps":[{"site":14,"line":1,"lines":[1],"start":25,"end":974,"kind":"call","label":"canCompleteCircuit","state":{"gas":{"$ref":"o1"},"cost":{"$ref":"o2"}},"input":{"gas":{"$ref":"o1"},"cost":{"$ref":"o2"}},"heap":{"o1":{"kind":"array","items":[1,2,3,4,5]},"o2":{"kind":"array","items":[3,4,5,1,2]}},"value":{"$scalar":"undefined"},"stack":["canCompleteCircuit"]},{"site":0,"line":3,"lines":[3],"start":112,"end":165,"kind":"statement","label":"const totalGas = gas.reduce((sum, g) => sum + g, 0);","state":{"gas":{"