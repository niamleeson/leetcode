{"id":647,"title":"Palindromic Substrings","topic":"1-D Dynamic Programming","code":"var countSubstrings = function(s) {\n    let count = 0;\n\n    for (let i = 0; i < s.length; i++) {\n\n        // --- Odd-length palindromes: single character center at i ---\n        let l = i;\n        let r = i;\n        while (l >= 0 && r < s.length && s[l] === s[r]) {\n            // Every valid expansion is a distinct palindromic substring\n            count++;\n            l--;\n            r++;\n        }\n\n        // --- Even-length palindromes: gap between i and i+1 as center ---\n        l = i;\n        r = i + 1;\n        while (l >= 0 && r < s.length && s[l] === s[r]) {\n            count++;\n            l--;\n            r++;\n        }\n    }\n\n    return count;\n};","sourceHash":"757718b0d558ff06eb3d25c87d9550652d3924fcd61b26e10fae3faa15755229","generatorHash":"d120be949580d04de09546df406ed5b5a640d1e6ded6b75fa128e96dd15f723b","fixtureHash":"95b9281bc9cef92cfd921e339906bb8f9464100a3584084361b38fbac4e9e5a7","examples":[{"name":"Example","input":["abc"],"expected":3,"result":3,"steps":[{"site":20,"line":1,"kind":"call","label":"countSubstrings","state":{"s":"abc"},"input":{"s":"abc"},"heap":{},"value":{"$scalar":"undefined"},"stack":["countSubstrings"]},{"site":0,"line":2,"kind":"statement","label":"let count = 0;","state":{"s":"abc","count":0},"input":{"s":"abc"},"heap":{},"value":{"$scalar":"undefined"},"stack":["countSubstrings"]},{"site":17,"line":4,"kind":"check","label":"i < s.length","state":{"i":0,"s":"abc","count":0},"input":{"s":"abc"},"heap":{},"value":true,"stack":["countSubstrings"]},{"site":1,"line":7,"kind":"statement","label":"let l = i;","state":{"l":0,"i":0,"s":"abc","count":0},"input":{"s":"abc"},"heap":{},"value":{"$scalar":"undefined"},"stack":["countSubstrings"]},{"site":2,"line":8,"kind":"statement","label":"let r = i;","state":{"l":0,"r":0,"i":0,"s":"abc","count":0},"input":{"s":"abc"},"heap":{},"value":{"$scalar":"undefined"},"stack":["countSu