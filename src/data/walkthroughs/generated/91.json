{"id":91,"title":"Decode Ways","topic":"1-D Dynamic Programming","code":"var numDecodings = function(s) {\n    // dp.get(i) = number of ways to decode s[i..]\n    const dp = new Map();\n\n    // Base case: empty suffix has exactly one valid decoding (the empty string)\n    dp.set(s.length, 1);\n\n    // Process the string right to left\n    for (let i = s.length - 1; i >= 0; i--) {\n        const currentChar = s[i];\n\n        if (currentChar === '0') {\n            // A leading zero cannot be decoded on its own\n            dp.set(i, 0);\n        } else {\n            // Option 1: decode s[i] as a single digit (always valid if not '0')\n            const waysUsingSingleDigit = dp.get(i + 1);\n            dp.set(i, waysUsingSingleDigit);\n\n            // Option 2: decode s[i..i+1] as a two-digit number (10–26)\n            if (i + 1 < s.length) {\n                const nextChar = s[i + 1];\n                const twoDigitIsValid =\n                    currentChar === '1' ||\n                    (currentChar === '2' && '0123456'.includes(nextChar));\n\n                if (twoDigitIsValid) {\n                    const waysUsingTwoDigits = dp.get(i + 2) ?? 0;\n                    dp.set(i, dp.get(i) + waysUsingTwoDigits);\n                }\n            }\n        }\n    }\n\n    return dp.get(0);\n};","sourceHash":"609b888dbcf222bdce9b33c3d792b2ef35aec5811ae1338bec7010e9ba001e87","generatorHash":"346a6be1776236e10a13a085800eed1d82b9ee73c013d4ee06a9045e463e80ed","fixtureHash":"17ef47413e242bcfd384a69060179e94d74cd764d9993047593032c90db59374","indexing":{"s":{"indices":["i"],"cells":[]}},"examples":[{"name":"Example","input":["12"],"expected":2,"result":2,"steps":[{"site":16,"line":1,"lines":[1],"start":19,"end":1210,"kind":"call","label":"numDecodings","state":{"s":"12"},"input":{"s":"12"},"heap":{},"value":{"$scalar":"undefined"},"stack":["numDecodings"]},{"site":0,"line":3,"lines":[3],"start":88,"end":109,"kind":"statement","label":"const dp = new Map();","state":{"s