{"id":997,"title":"Find the Town Judge","topic":"Graphs","code":"var findJudge = function(n, trust) {\n    // balance[i] = (number of people who trust i) - (number of people i trusts)\n    const balance = new Array(n + 1).fill(0);\n\n    for (const [truster, trusted] of trust) {\n        balance[truster]--;  // truster loses trust points (they trust someone)\n        balance[trusted]++;  // trusted gains trust points (being trusted)\n    }\n\n    // The judge is trusted by all n-1 others and trusts nobody\n    // So their balance must be exactly n-1\n    for (let person = 1; person <= n; person++) {\n        if (balance[person] === n - 1) return person;\n    }\n\n    return -1; // No judge found\n};","sourceHash":"d34efb2d8b7f93b4735c276847e71d11312fcf57d65fde716f72916989e81bf8","generatorHash":"d120be949580d04de09546df406ed5b5a640d1e6ded6b75fa128e96dd15f723b","fixtureHash":"95743e92dc9fb257eb47a111b67690b2fc7fec2608f0432705999ea96fef4130","examples":[{"name":"Example","input":[2,[[1,2]]],"expected":2,"result":2,"steps":[{"site":11,"line":1,"kind":"call","label":"findJudge","state":{"n":2,"trust":{"$ref":"o1"}},"input":{"n":2,"trust":{"$ref":"o1"}},"heap":{"o1":{"kind":"array","items":[{"$ref":"o2"}]},"o2":{"kind":"array","items":[1,2]}},"value":{"$scalar":"undefined"},"stack":["findJudge"]},{"site":0,"line":3,"kind":"operation","label":"new Array(n + 1).fill(0)","state":{"n":2,"trust":{"$ref":"o1"}},"input":{"n":2,"trust":{"$ref":"o1"}},"heap":{"o3":{"kind":"array","items":[0,0,0]}},"value":{"$ref":"o3"},"stack":["findJudge"]},{"site":1,"line":3,"kind":"statement","label":"const balance = new Array(n + 1).fill(0);","state":{"n":2,"trust":{"$ref":"o1"},"balance":{"$ref":"o3"}},"input":{"n":2,"trust":{"$ref":"o1"}},"heap":{},"value":{"$scalar":"undefined"},"stack":["findJudge"]},{"site":4,"line":5,"kind":"iterate","label":"const [truster, trusted] ← next","state":{"truster":1,"trusted":2,"n":2,"trust":{"$ref":"o1"},"balance":{"$ref":"o3"}},"input":{"n":2,"trust":{"$r