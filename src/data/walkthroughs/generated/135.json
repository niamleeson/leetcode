{"id":135,"title":"Candy","topic":"Greedy","code":"var candy = function(ratings) {\n    const n = ratings.length;\n\n    // Everyone starts with at least 1 candy\n    const candies = Array(n).fill(1);\n\n    // Left pass: give more candy than left neighbor if rating is higher\n    for (let i = 1; i < n; i = i + 1) {\n        if (ratings[i] > ratings[i - 1]) {\n            candies[i] = candies[i - 1] + 1;\n        }\n    }\n\n    // Right pass: give more candy than right neighbor if rating is higher\n    // Use max so we satisfy both left and right constraints\n    for (let i = n - 2; i >= 0; i = i - 1) {\n        if (ratings[i] > ratings[i + 1]) {\n            candies[i] = Math.max(candies[i], candies[i + 1] + 1);\n        }\n    }\n\n    // Sum all candies for the minimum total\n    return candies.reduce((total, count) => total + count, 0);\n};","sourceHash":"64e37a66c630916aaa7fdf4090b63dfb5330b89451d83cc70492f2c7e3edfa9f","generatorHash":"b66120ae1d9d0cfc0bba45cf6f5673ac49a7d0cba8100ee7e720869b46fddc24","fixtureHash":"1e447e04c56edbcbde17bc3435963515002ae448ee9aa6baf2b94b2c50dfb40b","indexing":{"ratings":{"indices":["i"],"cells":[]},"candies":{"indices":["i"],"cells":[]}},"examples":[{"name":"Example","input":[[1,0,2]],"expected":5,"result":5,"steps":[{"site":12,"line":1,"lines":[1],"start":12,"end":782,"kind":"call","label":"candy","state":{"ratings":{"$ref":"o1"}},"input":{"ratings":{"$ref":"o1"}},"heap":{"o1":{"kind":"array","items":[1,0,2]}},"value":{"$scalar":"undefined"},"stack":["candy"]},{"site":0,"line":2,"lines":[2],"start":36,"end":61,"kind":"statement","label":"const n = ratings.length;","state":{"ratings":{"$ref":"o1"},"n":3},"input":{"ratings":{"$ref":"o1"}},"heap":{},"value":{"$scalar":"undefined"},"stack":["candy"]},{"site":1,"line":5,"lines":[5],"start":128,"end":144,"kind":"operation","label":"Array(n).fill(1)","state":{"ratings":{"$ref":"o1"},"n":3},"input":{"ratings":{"$ref":"o1"}},"heap":{"o2":{"kind":"array","items":[1,1,1]}},"value":{"$ref"