{"id":374,"title":"Guess Number Higher Or Lower","topic":"Binary Search","code":"var guessNumber = function(n) {\n    let lo = 1;\n    let hi = n;\n\n    while (lo <= hi) {\n        const mid = Math.floor((lo + hi) / 2);\n\n        // API: guess(n) returns 0 if correct, -1 if picked < n, 1 if picked > n\n        const feedback = guess(mid);\n\n        if (feedback === 0) {\n            // Correct guess\n            return mid;\n        } else if (feedback === -1) {\n            // Picked number is lower than mid — search the left half\n            hi = mid - 1;\n        } else {\n            // Picked number is higher than mid — search the right half\n            lo = mid + 1;\n        }\n    }\n\n    return lo; // should always be found before here\n};","sourceHash":"949df3bd0cf412fa21359d709df5a3321273cc2fd383004968f72546506c9706","generatorHash":"b66120ae1d9d0cfc0bba45cf6f5673ac49a7d0cba8100ee7e720869b46fddc24","fixtureHash":"a188b890c2e04e55e42ad254026f8af21e3913155f990211c2cfb9f4a17306b4","indexing":{},"examples":[{"name":"Example","input":[10],"expected":6,"result":6,"steps":[{"site":11,"line":1,"lines":[1],"start":18,"end":658,"kind":"call","label":"guessNumber","state":{"n":10},"input":{"n":10},"heap":{},"value":{"$scalar":"undefined"},"stack":["guessNumber"]},{"site":0,"line":2,"lines":[2],"start":36,"end":47,"kind":"statement","label":"let lo = 1;","state":{"n":10,"lo":1},"input":{"n":10},"heap":{},"value":{"$scalar":"undefined"},"stack":["guessNumber"]},{"site":1,"line":3,"lines":[3],"start":52,"end":63,"kind":"statement","label":"let hi = n;","state":{"n":10,"lo":1,"hi":10},"input":{"n":10},"heap":{},"value":{"$scalar":"undefined"},"stack":["guessNumber"]},{"site":9,"line":5,"lines":[5],"start":76,"end":84,"kind":"check","label":"lo <= hi","state":{"n":10,"lo":1,"hi":10},"input":{"n":10},"heap":{},"value":true,"stack":["guessNumber"]},{"site":2,"line":6,"lines":[6],"start":96,"end":134,"kind":"statement","label":"const mid = Math.floor((lo + hi) / 2);","