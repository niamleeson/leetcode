{"id":338,"title":"Counting Bits","topic":"Bit Manipulation","code":"var countBits = function(n) {\n    // dp[i] = number of 1-bits in i\n    const dp = new Array(n + 1).fill(0);\n    // dp[0] = 0 by default (zero has no set bits)\n\n    for (let i = 1; i <= n; i++) {\n        // i >> 1 is i with its last bit removed (i.e., i // 2)\n        // We already know dp[i >> 1] from a previous iteration\n        const bitsWithoutLastBit = dp[i >> 1];\n\n        // i & 1 is 1 if i is odd (last bit is set), 0 if i is even\n        const lastBit = i & 1;\n\n        dp[i] = bitsWithoutLastBit + lastBit;\n    }\n\n    return dp;\n};","sourceHash":"d4298d2a7d9ed55d68d42ea30c5406513672e29aa2ec397fdf352808dd8646c8","generatorHash":"d120be949580d04de09546df406ed5b5a640d1e6ded6b75fa128e96dd15f723b","fixtureHash":"8ce0f1f635e554fbea8f1f0c9fe722c14f9a61cf45f9cc8e89058eed3462927e","examples":[{"name":"Example","input":[2],"expected":[0,1,1],"result":[0,1,1],"steps":[{"site":8,"line":1,"kind":"call","label":"countBits","state":{"n":2},"input":{"n":2},"heap":{},"value":{"$scalar":"undefined"},"stack":["countBits"]},{"site":0,"line":3,"kind":"operation","label":"new Array(n + 1).fill(0)","state":{"n":2},"input":{"n":2},"heap":{"o1":{"kind":"array","items":[0,0,0]}},"value":{"$ref":"o1"},"stack":["countBits"]},{"site":1,"line":3,"kind":"statement","label":"const dp = new Array(n + 1).fill(0);","state":{"n":2,"dp":{"$ref":"o1"}},"input":{"n":2},"heap":{},"value":{"$scalar":"undefined"},"stack":["countBits"]},{"site":5,"line":6,"kind":"check","label":"i <= n","state":{"i":1,"n":2,"dp":{"$ref":"o1"}},"input":{"n":2},"heap":{},"value":true,"stack":["countBits"]},{"site":2,"line":9,"kind":"statement","label":"const bitsWithoutLastBit = dp[i >> 1];","state":{"bitsWithoutLastBit":0,"i":1,"n":2,"dp":{"$ref":"o1"}},"input":{"n":2},"heap":{},"value":{"$scalar":"undefined"},"stack":["countBits"]},{"site":3,"line":12,"kind":"statement","label":"const lastBit = i & 1;","state":{"bitsWithoutLastBit":0,"l