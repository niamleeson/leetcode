{"id":33,"title":"Search In Rotated Sorted Array","topic":"Binary Search","code":"var search = function(nums, target) {\n    let lo = 0;\n    let hi = nums.length - 1;\n\n    while (lo <= hi) {\n        const mid = Math.floor((lo + hi) / 2);\n        const midValue = nums[mid];\n\n        if (midValue === target) {\n            return mid;\n        }\n\n        const leftHalfIsSorted = nums[lo] <= midValue;\n\n        if (leftHalfIsSorted) {\n            // Check if target falls within the sorted left half\n            const targetInLeftHalf = nums[lo] <= target && target < midValue;\n            if (targetInLeftHalf) {\n                hi = mid - 1;\n            } else {\n                lo = mid + 1;\n            }\n        } else {\n            // Right half must be sorted — check if target falls there\n            const targetInRightHalf = midValue < target && target <= nums[hi];\n            if (targetInRightHalf) {\n                lo = mid + 1;\n            } else {\n                hi = mid - 1;\n            }\n        }\n    }\n\n    return -1;\n};","sourceHash":"7e4d835df441ea553e9b59f14e8d968ac941d497a5230184f21e0bb33feabd43","generatorHash":"d120be949580d04de09546df406ed5b5a640d1e6ded6b75fa128e96dd15f723b","fixtureHash":"2d7d35aae322befbfb91f6e8733ad7e89e97b9f2e9e96152104853a56bae4416","examples":[{"name":"Example","input":[[4,5,6,7,0,1,2],0],"expected":4,"result":4,"steps":[{"site":20,"line":1,"kind":"call","label":"search","state":{"nums":{"$ref":"o1"},"target":0},"input":{"nums":{"$ref":"o1"},"target":0},"heap":{"o1":{"kind":"array","items":[4,5,6,7,0,1,2]}},"value":{"$scalar":"undefined"},"stack":["search"]},{"site":0,"line":2,"kind":"statement","label":"let lo = 0;","state":{"nums":{"$ref":"o1"},"target":0,"lo":0},"input":{"nums":{"$ref":"o1"},"target":0},"heap":{},"value":{"$scalar":"undefined"},"stack":["search"]},{"site":1,"line":3,"kind":"statement","label":"let hi = nums.length - 1;","state":{"nums":{"$ref":"o1"},"target":0,"lo":0,"hi":6},"inpu