{"id":67,"title":"Add Binary","topic":"Bit Manipulation","code":"var addBinary = function(a, b) {\n    const result = [];\n    let carry = 0;\n\n    // Process both strings from right to left (least significant bit first)\n    let i = a.length - 1;\n    let j = b.length - 1;\n\n    while (i >= 0 || j >= 0 || carry > 0) {\n        let total = carry;\n\n        // Add bit from string a (treat missing positions as 0)\n        if (i >= 0) {\n            total = total + Number(a[i]);\n            i = i - 1;\n        }\n\n        // Add bit from string b\n        if (j >= 0) {\n            total = total + Number(b[j]);\n            j = j - 1;\n        }\n\n        // Current bit is total % 2; carry is total / 2\n        result.push(String(total % 2));\n        carry = Math.floor(total / 2);\n    }\n\n    // Result was built in reverse order\n    return result.reverse().join('');\n};","sourceHash":"7a2425f1ef2382b306b3e919bbb632c8fca4a0558913ce5fcfdcc9bd8b8a12ae","generatorHash":"d120be949580d04de09546df406ed5b5a640d1e6ded6b75fa128e96dd15f723b","fixtureHash":"a455bfc3424bfe2def68c00082e7c4a8405d9bd84484d91cac13b250f8f9e615","examples":[{"name":"Example","input":["11","1"],"expected":"100","result":"100","steps":[{"site":19,"line":1,"kind":"call","label":"addBinary","state":{"a":"11","b":"1"},"input":{"a":"11","b":"1"},"heap":{},"value":{"$scalar":"undefined"},"stack":["addBinary"]},{"site":0,"line":2,"kind":"statement","label":"const result = [];","state":{"a":"11","b":"1","result":{"$ref":"o1"}},"input":{"a":"11","b":"1"},"heap":{"o1":{"kind":"array","items":[]}},"value":{"$scalar":"undefined"},"stack":["addBinary"]},{"site":1,"line":3,"kind":"statement","label":"let carry = 0;","state":{"a":"11","b":"1","result":{"$ref":"o1"},"carry":0},"input":{"a":"11","b":"1"},"heap":{},"value":{"$scalar":"undefined"},"stack":["addBinary"]},{"site":2,"line":6,"kind":"statement","label":"let i = a.length - 1;","state":{"a":"11","b":"1","result":{"$ref":"o1"},"carry":0,"i":1},"input":{"