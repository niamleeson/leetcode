{"id":67,"title":"Add Binary","topic":"Bit Manipulation","code":"var addBinary = function(a, b) {\n    const result = [];\n    let carry = 0;\n\n    // Process both strings from right to left (least significant bit first)\n    let i = a.length - 1;\n    let j = b.length - 1;\n\n    while (i >= 0 || j >= 0 || carry > 0) {\n        let total = carry;\n\n        // Add bit from string a (treat missing positions as 0)\n        if (i >= 0) {\n            total = total + Number(a[i]);\n            i = i - 1;\n        }\n\n        // Add bit from string b\n        if (j >= 0) {\n            total = total + Number(b[j]);\n            j = j - 1;\n        }\n\n        // Current bit is total % 2; carry is total / 2\n        result.push(String(total % 2));\n        carry = Math.floor(total / 2);\n    }\n\n    // Result was built in reverse order\n    return result.reverse().join('');\n};","sourceHash":"7a2425f1ef2382b306b3e919bbb632c8fca4a0558913ce5fcfdcc9bd8b8a12ae","generatorHash":"346a6be1776236e10a13a085800eed1d82b9ee73c013d4ee06a9045e463e80ed","fixtureHash":"a455bfc3424bfe2def68c00082e7c4a8405d9bd84484d91cac13b250f8f9e615","indexing":{"a":{"indices":["i"],"cells":[]},"b":{"indices":["j"],"cells":[]}},"examples":[{"name":"Example","input":["11","1"],"expected":"100","result":"100","steps":[{"site":16,"line":1,"lines":[1],"start":16,"end":793,"kind":"call","label":"addBinary","state":{"a":"11","b":"1"},"input":{"a":"11","b":"1"},"heap":{},"value":{"$scalar":"undefined"},"stack":["addBinary"]},{"site":0,"line":2,"lines":[2],"start":37,"end":55,"kind":"statement","label":"const result = [];","state":{"a":"11","b":"1","result":{"$ref":"o1"}},"input":{"a":"11","b":"1"},"heap":{"o1":{"kind":"array","items":[]}},"value":{"$scalar":"undefined"},"stack":["addBinary"]},{"site":1,"line":3,"lines":[3],"start":60,"end":74,"kind":"statement","label":"let carry = 0;","state":{"a":"11","b":"1","result":{"$ref":"o1"},"carry":0},"input":{"a":"11","b":"1"},"heap":{},"value":{"$scalar":"undef