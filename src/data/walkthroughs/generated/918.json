{"id":918,"title":"Maximum Sum Circular Subarray","topic":"Greedy","code":"var maxSubarraySumCircular = function(nums) {\n    let total = 0;\n\n    // Track maximum subarray (Kadane's)\n    let maxSum = -Infinity;\n    let curMax = -Infinity;\n\n    // Track minimum subarray (for circular case)\n    let minSum = Infinity;\n    let curMin = Infinity;\n\n    for (const num of nums) {\n        total += num;\n\n        // Kadane's for max subarray\n        curMax = Math.max(curMax + num, num);\n        maxSum = Math.max(maxSum, curMax);\n\n        // Kadane's for min subarray (circular max = total - min)\n        curMin = Math.min(curMin + num, num);\n        minSum = Math.min(minSum, curMin);\n    }\n\n    // Edge case: all elements negative -> circular case would be empty, use maxSum\n    if (maxSum < 0) return maxSum;\n\n    // Compare non-circular max with circular max (total - minSubarray)\n    return Math.max(maxSum, total - minSum);\n};","sourceHash":"3545b743105668258f9123d3e2e7bf545b1a5e13af928b116f81d112c1b28466","generatorHash":"b66120ae1d9d0cfc0bba45cf6f5673ac49a7d0cba8100ee7e720869b46fddc24","fixtureHash":"af2365040fe97024a6e0dda75830a3b4bed0aadbf87837a9578f72e9f10c7cef","indexing":{},"examples":[{"name":"Example","input":[[1,-2,3,-2]],"expected":3,"result":3,"steps":[{"site":15,"line":1,"lines":[1],"start":29,"end":849,"kind":"call","label":"maxSubarraySumCircular","state":{"nums":{"$ref":"o1"}},"input":{"nums":{"$ref":"o1"}},"heap":{"o1":{"kind":"array","items":[1,-2,3,-2]}},"value":{"$scalar":"undefined"},"stack":["maxSubarraySumCircular"]},{"site":0,"line":2,"lines":[2],"start":50,"end":64,"kind":"statement","label":"let total = 0;","state":{"nums":{"$ref":"o1"},"total":0},"input":{"nums":{"$ref":"o1"}},"heap":{},"value":{"$scalar":"undefined"},"stack":["maxSubarraySumCircular"]},{"site":1,"line":5,"lines":[5],"start":111,"end":134,"kind":"statement","label":"let maxSum = -Infinity;","state":{"nums":{"$ref":"o1"},"total":0,"maxSum":{"$scalar":"-Infinity