{"id":518,"title":"Coin Change II","topic":"2-D Dynamic Programming","code":"var change = function(amount, coins) {\n    // dp[a] = number of combinations that sum to amount a\n    const dp = new Array(amount + 1).fill(0);\n\n    // Base case: there is exactly one way to make amount 0 (use no coins)\n    dp[0] = 1;\n\n    // Outer loop over coins ensures each combination is counted once,\n    // not as different permutations (e.g., [1,2] and [2,1] count as the same)\n    for (const coin of coins) {\n        // For each amount at least as large as this coin, add the ways\n        // to make (amount - coin) — effectively \"use one more of this coin\"\n        for (let a = coin; a <= amount; a++) {\n            const waysWithoutThisCoin = dp[a];\n            const waysUsingOneCoin    = dp[a - coin];\n\n            dp[a] = waysWithoutThisCoin + waysUsingOneCoin;\n        }\n    }\n\n    return dp[amount];\n};","sourceHash":"c6b6103e2f4b2422f4a04e0c62283b7ac4808ecd467783504cacc6562e9a7721","generatorHash":"d120be949580d04de09546df406ed5b5a640d1e6ded6b75fa128e96dd15f723b","fixtureHash":"99a889e30902fe9142ba5d81f522d4f3f05c41c866060617a0a1cb6be99a536c","examples":[{"name":"Example","input":[5,[1,2,5]],"expected":4,"result":4,"steps":[{"site":11,"line":1,"kind":"call","label":"change","state":{"amount":5,"coins":{"$ref":"o1"}},"input":{"amount":5,"coins":{"$ref":"o1"}},"heap":{"o1":{"kind":"array","items":[1,2,5]}},"value":{"$scalar":"undefined"},"stack":["change"]},{"site":0,"line":3,"kind":"operation","label":"new Array(amount + 1).fill(0)","state":{"amount":5,"coins":{"$ref":"o1"}},"input":{"amount":5,"coins":{"$ref":"o1"}},"heap":{"o2":{"kind":"array","items":[0,0,0,0,0,0]}},"value":{"$ref":"o2"},"stack":["change"]},{"site":1,"line":3,"kind":"statement","label":"const dp = new Array(amount + 1).fill(0);","state":{"amount":5,"coins":{"$ref":"o1"},"dp":{"$ref":"o2"}},"input":{"amount":5,"coins":{"$ref":"o1"}},"heap":{},"value":{"$scalar":"undefined"},"stack":["change"]},{