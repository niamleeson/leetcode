{"id":50,"title":"Pow(x, n)","topic":"Math & Geometry","code":"var myPow = function(x, n) {\n    // Handle negative exponents: x^(-n) = (1/x)^n\n    if (n < 0) {\n        x = 1 / x;\n        n = -n;\n    }\n\n    let result = 1.0;\n\n    // Binary exponentiation: halve the exponent each iteration\n    while (n > 0) {\n        // If the current bit of n is set, multiply result by current x\n        if (n % 2 === 1) {\n            result = result * x;\n        }\n\n        // Square x to handle the next bit\n        x = x * x;\n\n        // Shift n right by 1 bit\n        n = Math.floor(n / 2);\n    }\n\n    return result;\n};","sourceHash":"dd79c58b3377441ffbc5d27eace7367d30b202482d1aa1a49539cdab531a7ec7","generatorHash":"346a6be1776236e10a13a085800eed1d82b9ee73c013d4ee06a9045e463e80ed","fixtureHash":"9b4265468de9acdfb25801ab72e04cc0a37dca5f3e5aa0107eac74605417aa36","indexing":{},"examples":[{"name":"Example","input":[2,10],"expected":1024,"result":1024,"steps":[{"site":10,"line":1,"lines":[1],"start":12,"end":544,"kind":"call","label":"myPow","state":{"x":2,"n":10},"input":{"x":2,"n":10},"heap":{},"value":{"$scalar":"undefined"},"stack":["myPow"]},{"site":2,"line":3,"lines":[3],"start":88,"end":93,"kind":"check","label":"n < 0","state":{"x":2,"n":10},"input":{"x":2,"n":10},"heap":{},"value":false,"stack":["myPow"]},{"site":3,"line":8,"lines":[8],"start":143,"end":160,"kind":"statement","label":"let result = 1.0;","state":{"x":2,"n":10,"result":1},"input":{"x":2,"n":10},"heap":{},"value":{"$scalar":"undefined"},"stack":["myPow"]},{"site":8,"line":11,"lines":[11],"start":237,"end":242,"kind":"check","label":"n > 0","state":{"x":2,"n":10,"result":1},"input":{"x":2,"n":10},"heap":{},"value":true,"stack":["myPow"]},{"site":5,"line":13,"lines":[13],"start":330,"end":341,"kind":"check","label":"n % 2 === 1","state":{"x":2,"n":10,"result":1},"input":{"x":2,"n":10},"heap":{},"value":false,"stack":["myPow"]},{"site":6,"line":18,"lines":[18],"start":440,"end":450,"kind":"state