{"id":778,"title":"Swim In Rising Water","topic":"Advanced Graphs","code":"var swimInWater = function(grid) {\n    const n = grid.length;\n\n    // Track visited cells to avoid reprocessing\n    const visited = Array(n)\n        .fill(null)\n        .map(() => new Array(n).fill(false));\n\n    const heap = new MinHeap();\n    heap.push([grid[0][0], 0, 0]);\n    visited[0][0] = true;\n\n    const directions = [[0, 1], [0, -1], [1, 0], [-1, 0]];\n\n    while (heap.size > 0) {\n        const [timeRequired, row, col] = heap.pop();\n\n        // Reached the bottom-right corner\n        if (row === n - 1 && col === n - 1) {\n            return timeRequired;\n        }\n\n        // Explore all 4 neighbors\n        for (const [deltaRow, deltaCol] of directions) {\n            const newRow = row + deltaRow;\n            const newCol = col + deltaCol;\n\n            const inBounds = newRow >= 0 && newRow < n && newCol >= 0 && newCol < n;\n\n            if (inBounds && !visited[newRow][newCol]) {\n                visited[newRow][newCol] = true;\n\n                // Time to reach neighbor = max of current time and neighbor's elevation\n                const timeToReachNeighbor = Math.max(timeRequired, grid[newRow][newCol]);\n                heap.push([timeToReachNeighbor, newRow, newCol]);\n            }\n        }\n    }\n\n    return -1;\n};","sourceHash":"faffb65748ca899606d1d257c1c3caa8d1c970320c8626c70539efc7b62f9146","generatorHash":"11832ca6ffa742e145e95da76076cf2abd9c99e13ce5861fd842744f6a373701","fixtureHash":"648978db39c9ef2c4f6dc1faca6cfdd9d2c9ab19f285bdcf514aa8331002fec0","indexing":{"visited":{"indices":["newRow"],"cells":[["newRow","newCol"]]},"grid":{"indices":["newRow"],"cells":[["newRow","newCol"]]}},"examples":[{"name":"Example","input":[[[0,2],[1,3]]],"expected":3,"result":3,"steps":[{"site":25,"line":1,"lines":[1],"start":18,"end":1239,"kind":"call","label":"swimInWater","state":{"grid":{"$ref":"o1"}},"input":{"grid":{"$ref":"o1"}},"heap":{"o1":{"kind":"ar