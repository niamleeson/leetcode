{"id":168,"title":"Excel Sheet Column Title","topic":"Math & Geometry","code":"var convertToTitle = function(columnNumber) {\n    const result = [];\n\n    while (columnNumber > 0) {\n        // Subtract 1 to convert 1-indexed to 0-indexed (A=0, B=1, ..., Z=25)\n        columnNumber = columnNumber - 1;\n\n        // Get the current digit (0-25) and convert to letter\n        const digitIndex = columnNumber % 26;\n        const letter = String.fromCharCode(digitIndex + 65); // 65 = 'A'\n        result.push(letter);\n\n        // Move to the next digit position\n        columnNumber = Math.floor(columnNumber / 26);\n    }\n\n    // Built in reverse order, so reverse to get correct title\n    return result.reverse().join('');\n};","sourceHash":"cba5c08a7459c54c0ee658ffcc887797f5ef78790f7a46c011142b6935d45b90","generatorHash":"b66120ae1d9d0cfc0bba45cf6f5673ac49a7d0cba8100ee7e720869b46fddc24","fixtureHash":"c740577cc325bc21fc5badc19c0012bdb131d50a172eb50a1aae588ac276dc9c","indexing":{},"examples":[{"name":"Example","input":[701],"expected":"ZY","result":"ZY","steps":[{"site":10,"line":1,"lines":[1],"start":21,"end":638,"kind":"call","label":"convertToTitle","state":{"columnNumber":701},"input":{"columnNumber":701},"heap":{},"value":{"$scalar":"undefined"},"stack":["convertToTitle"]},{"site":0,"line":2,"lines":[2],"start":50,"end":68,"kind":"statement","label":"const result = [];","state":{"columnNumber":701,"result":{"$ref":"o1"}},"input":{"columnNumber":701},"heap":{"o1":{"kind":"array","items":[]}},"value":{"$scalar":"undefined"},"stack":["convertToTitle"]},{"site":7,"line":4,"lines":[4],"start":81,"end":97,"kind":"check","label":"columnNumber > 0","state":{"columnNumber":701,"result":{"$ref":"o1"}},"input":{"columnNumber":701},"heap":{},"value":true,"stack":["convertToTitle"]},{"site":1,"line":6,"lines":[6],"start":187,"end":219,"kind":"statement","label":"columnNumber = columnNumber - 1;","state":{"columnNumber":700,"result":{"$ref":"o1"}},"input":{"columnNumber":701