{"id":371,"title":"Sum of Two Integers","topic":"Bit Manipulation","code":"var getSum = function(a, b) {\n    while (b !== 0) {\n        // carry: bits where BOTH a and b are 1 — these generate a carry to the next position\n        const carry = (a & b) << 1;\n\n        // XOR gives the sum of bits WITHOUT the carry (each bit added independently)\n        a = a ^ b;\n\n        // The carry becomes the new \"b\" to be added in the next round\n        b = carry;\n\n        // Use bitwise OR with 0 to keep values as signed 32-bit integers\n        // This handles negative numbers correctly in JavaScript\n        a = a | 0;\n        b = b | 0;\n    }\n\n    // When b is 0, there is no more carry — a holds the final sum\n    return a;\n};","sourceHash":"f9af31a8b9bb27811c993cae540b592a0c9a9bf6d88d1a57b57f5fa845e52b1d","generatorHash":"b66120ae1d9d0cfc0bba45cf6f5673ac49a7d0cba8100ee7e720869b46fddc24","fixtureHash":"8f444aef0c54c379414d48a58985a8e9401458e9086b7271565de720ca0de630","indexing":{},"examples":[{"name":"Example","input":[1,2],"expected":3,"result":3,"steps":[{"site":7,"line":1,"lines":[1],"start":13,"end":646,"kind":"call","label":"getSum","state":{"a":1,"b":2},"input":{"a":1,"b":2},"heap":{},"value":{"$scalar":"undefined"},"stack":["getSum"]},{"site":5,"line":2,"lines":[2],"start":41,"end":48,"kind":"check","label":"b !== 0","state":{"a":1,"b":2},"input":{"a":1,"b":2},"heap":{},"value":true,"stack":["getSum"]},{"site":0,"line":4,"lines":[4],"start":154,"end":181,"kind":"statement","label":"const carry = (a & b) << 1;","state":{"carry":0,"a":1,"b":2},"input":{"a":1,"b":2},"heap":{},"value":{"$scalar":"undefined"},"stack":["getSum"]},{"site":1,"line":7,"lines":[7],"start":277,"end":287,"kind":"statement","label":"a = a ^ b;","state":{"carry":0,"a":3,"b":2},"input":{"a":1,"b":2},"heap":{},"value":{"$scalar":"undefined"},"stack":["getSum"]},{"site":2,"line":10,"lines":[10],"start":368,"end":378,"kind":"statement","label":"b = carry;","state":{"carry":0,"a":3,"b":0