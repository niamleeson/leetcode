{"id":502,"title":"IPO","topic":"Heap / Priority Queue","code":"class MinHeap {\n    constructor(compare = (left, right) => left - right) {\n        this.items = [];\n        this.compare = compare;\n    }\n\n    size() { return this.items.length; }\n    isEmpty() { return this.items.length === 0; }\n    front() { return this.items[0]; }\n\n    enqueue(value) {\n        this.items.push(value);\n        let index = this.items.length - 1;\n        while (index > 0) {\n            const parent = Math.floor((index - 1) / 2);\n            if (this.compare(this.items[parent], this.items[index]) <= 0) break;\n            [this.items[parent], this.items[index]] = [this.items[index], this.items[parent]];\n            index = parent;\n        }\n    }\n\n    dequeue() {\n        if (this.isEmpty()) return undefined;\n        const first = this.items[0];\n        const last = this.items.pop();\n        if (!this.isEmpty()) {\n            this.items[0] = last;\n            let index = 0;\n            while (true) {\n                const left = index * 2 + 1;\n                const right = left + 1;\n                let smallest = index;\n                if (left < this.size() && this.compare(this.items[left], this.items[smallest]) < 0) smallest = left;\n                if (right < this.size() && this.compare(this.items[right], this.items[smallest]) < 0) smallest = right;\n                if (smallest === index) break;\n                [this.items[index], this.items[smallest]] = [this.items[smallest], this.items[index]];\n                index = smallest;\n            }\n        }\n        return first;\n    }\n}\n\nvar findMaximizedCapital = function(k, w, profits, capital) {\n    const projects = capital.map((required, index) => [required, profits[index]]);\n    projects.sort((a, b) => a[0] - b[0]);\n    const available = new MinHeap((a, b) => b - a);\n    let next = 0;\n    for (let chosen = 0; chosen < k; chosen++) {\n        while (next < projects.length && projects[next][0] <= w) {\n            available.enqueue(projects[next][1]);\n            next++;\n        }\n        if (available.isEmpty()) break;\n        w += available.dequeue();\n    }\n    return w;\n};","sourceHash":"c1615c9901b5a53bad8ddb7409744283f5934a20c3d0cf4909be09016778afdb","generatorHash":"346a6be1776236e10a13a085800eed1d82b9ee73c013d4ee06a9045e463e80ed","fixtureHash":"aa3730e77b4296801469d12a2a57dd22664c82d1df5597b5550189986b28031d","indexing":{"this.items":{"indices":["parent","index","left","smallest","right"],"cells":[]},"profits":{"indices":["index"],"cells":[]},"projects":{"indices":["next"],"cells":[]}},"examples":[{"name":"Example","input":[2,0,[1,2,3],[0,1,1]],"expected":4,"result":4,"steps":[{"site":55,"line":44,"lines":[44],"start":1552,"end":2073,"kind":"call","label":"findMaximizedCapital","state":{"k":2,"w":0,"profits":{"$ref":"o1"},"capital":{"$ref":"o2"}},"input":{"k":2,"w":0,"profits":{"$ref":"o1"},"capital":{"$ref":"o2"}},"heap":{"o1":{"kind":"array","items":[1,2,3]},"o2":{"kind":"array","items":[0,1,1]}},"value":{"$scalar":"undefined"},"stack":["findMaximizedCapital"]},{"site":42,"line":45,"lines":[45],"start":1591,"end":1669,"kind":"statement","label":"const projects = capital.map((required, index) => [required, profits[index]]);","state":{"k":2,"w":0,"profits":{"$ref":"o1"},"capital":{"$ref":"o2"},"projects":{"$ref":"o3"}},"input":{"k":2,"w":0,"profits":{"$ref":"o1"},"capital":{"$ref":"o2"}},"heap":{"o3":{"kind":"array","items":[{"$ref":"o4"},{"$ref":"o5"},{"$ref":"o6"}]},"o4":{"kind":"array","items":[0,1]},"o5":{"kind":"array","items":[1,2]},"o6":{"kind":"array","items":[1,3]}},"value":{"$scalar":"undefined"},"stack":["findMaximizedCapital"]},{"site":43,"line":46,"lines":[46],"start":1674,"end":1710,"kind":"operation","label":"projects.sort((a, b) => a[0] - b[0])","state":{"k":2,"w":0,"profits":{"$ref":"o1"},"capital":{"$ref":"o2"},"projects":{"$ref":"o3"}},"input":{"k":2,"w":0,"profits":{"$ref":"o1"},"capital":{"$ref":"o2"}},"heap":{},"valu