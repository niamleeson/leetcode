{"id":150,"title":"Evaluate Reverse Polish Notation","topic":"Stack","code":"var evalRPN = function(tokens) {\n    const stack = [];\n    const operators = new Set(['+', '-', '*', '/']);\n\n    for (const token of tokens) {\n        const isOperator = operators.has(token);\n\n        if (isOperator) {\n            // Pop in reverse order: b is the right operand, a is the left\n            const rightOperand = stack.pop();\n            const leftOperand = stack.pop();\n\n            let result;\n            if (token === '+') {\n                result = leftOperand + rightOperand;\n            } else if (token === '-') {\n                result = leftOperand - rightOperand;\n            } else if (token === '*') {\n                result = leftOperand * rightOperand;\n            } else if (token === '/') {\n                // Truncate toward zero (not floor)\n                result = Math.trunc(leftOperand / rightOperand);\n            }\n\n            stack.push(result);\n        } else {\n            // It's a number — push it onto the stack\n            stack.push(parseInt(token));\n        }\n    }\n\n    // The final remaining value is the answer\n    return stack[0];\n};","sourceHash":"89e4eb1325f19c922a0584e555dba5a584923650113f5422ce00f42d7e921398","generatorHash":"346a6be1776236e10a13a085800eed1d82b9ee73c013d4ee06a9045e463e80ed","fixtureHash":"e0fee06c77222a83cacdef6c13d47eb40b4f54cb36f08dad713eba07bc2619af","indexing":{},"examples":[{"name":"Example","input":[["2","1","+","3","*"]],"expected":9,"result":9,"steps":[{"site":22,"line":1,"lines":[1],"start":14,"end":1084,"kind":"call","label":"evalRPN","state":{"tokens":{"$ref":"o1"}},"input":{"tokens":{"$ref":"o1"}},"heap":{"o1":{"kind":"array","items":["2","1","+","3","*"]}},"value":{"$scalar":"undefined"},"stack":["evalRPN"]},{"site":0,"line":2,"lines":[2],"start":37,"end":54,"kind":"statement","label":"const stack = [];","state":{"tokens":{"$ref":"o1"},"stack":{"$ref":"o2"}},"input":{"tokens":{"$ref":"o1"}