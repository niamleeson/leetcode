{"id":658,"title":"Find K Closest Elements","topic":"Sliding Window","code":"var findClosestElements = function(arr, k, x) {\n    // Binary search for the optimal starting index of the k-element window\n    // The window spans arr[lo .. lo+k-1]\n    let lo = 0;\n    let hi = arr.length - k;\n\n    while (lo < hi) {\n        const mid = (lo + hi) >> 1;\n\n        // Compare distances: is x closer to arr[mid] or arr[mid+k]?\n        // arr[mid] is the left boundary, arr[mid+k] is the right boundary\n        const distanceToLeft = x - arr[mid];\n        const distanceToRight = arr[mid + k] - x;\n\n        if (distanceToLeft > distanceToRight) {\n            // arr[mid] is farther: shift window to the right\n            lo = mid + 1;\n        } else {\n            // arr[mid+k] is farther or equal: shift window to the left (keep mid)\n            hi = mid;\n        }\n    }\n\n    // lo is now the optimal starting index\n    return arr.slice(lo, lo + k);\n};","sourceHash":"d3479aa9d2bcb7f5d62dd574f5cc1d32ade3221fff28821dc0affb4d40e13864","generatorHash":"b66120ae1d9d0cfc0bba45cf6f5673ac49a7d0cba8100ee7e720869b46fddc24","fixtureHash":"fb8b5db72713daf791f3653a1e3f112ecf58e6a1c71758706e02490c44b28316","indexing":{"arr":{"indices":["mid"],"cells":[]}},"examples":[{"name":"Example","input":[[1,2,3,4,5],4,3],"expected":[1,2,3,4],"result":[1,2,3,4],"steps":[{"site":10,"line":1,"lines":[1],"start":26,"end":865,"kind":"call","label":"findClosestElements","state":{"arr":{"$ref":"o1"},"k":4,"x":3},"input":{"arr":{"$ref":"o1"},"k":4,"x":3},"heap":{"o1":{"kind":"array","items":[1,2,3,4,5]}},"value":{"$scalar":"undefined"},"stack":["findClosestElements"]},{"site":0,"line":4,"lines":[4],"start":170,"end":181,"kind":"statement","label":"let lo = 0;","state":{"arr":{"$ref":"o1"},"k":4,"x":3,"lo":0},"input":{"arr":{"$ref":"o1"},"k":4,"x":3},"heap":{},"value":{"$scalar":"undefined"},"stack":["findClosestElements"]},{"site":1,"line":5,"lines":[5],"start":186,"end":210,"kind":"statement","l