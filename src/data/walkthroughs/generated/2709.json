{"id":2709,"title":"Greatest Common Divisor Traversal","topic":"Advanced Graphs","code":"var canTraverseAllPairs = function(nums) {\n    const n = nums.length;\n\n    // Edge cases\n    if (n === 1) return true;             // single element, trivially connected\n    if (nums.includes(1)) return false;   // 1 has no common prime with anyone (gcd=1 always)\n\n    // Union-Find\n    const parent = Array.from({length: n}, (_, i) => i);\n\n    function find(x) {\n        while (parent[x] !== x) {\n            parent[x] = parent[parent[x]]; // path halving\n            x = parent[x];\n        }\n        return x;\n    }\n\n    function union(a, b) {\n        a = find(a);\n        b = find(b);\n        if (a !== b) parent[a] = b;\n    }\n\n    // primeToIdx: prime factor -> index of first element with this factor\n    const primeToIdx = new Map();\n\n    for (let i = 0; i < n; i++) {\n        let num = nums[i];\n        let d = 2;\n\n        // Factorize num into prime factors\n        while (d * d <= num) {\n            if (num % d === 0) {\n                if (primeToIdx.has(d)) {\n                    // Another element already has this prime factor — connect them\n                    union(i, primeToIdx.get(d));\n                } else {\n                    // First element with this prime factor\n                    primeToIdx.set(d, i);\n                }\n                // Divide out all occurrences of d\n                while (num % d === 0) {\n                    num = Math.floor(num / d);\n                }\n            }\n            d++;\n        }\n\n        // If num > 1, it's a prime factor greater than sqrt(original num)\n        if (num > 1) {\n            if (primeToIdx.has(num)) {\n                union(i, primeToIdx.get(num));\n            } else {\n                primeToIdx.set(num, i);\n            }\n        }\n    }\n\n    // Check if all indices share the same root\n    const root = find(0);\n    for (let i = 1; i < n; i++) {\n        if (find(i) !== root) return false;\n    }\n    return true;\n};","sourceHash":"162cbe03f8fff7cebe8e15a901182a9c33de7d3f122fd3730d3d6df04fdeec9a","generatorHash":"b66120ae1d9d0cfc0bba45cf6f5673ac49a7d0cba8100ee7e720869b46fddc24","fixtureHash":"be72a007ca6469923c833957c312cdcff5848440de38b91836bc6e1b5f79040d","indexing":{"parent":{"indices":["x","a"],"cells":[]},"nums":{"indices":["i"],"cells":[]}},"examples":[{"name":"Example","input":[[2,3,6]],"expected":true,"result":true,"steps":[{"site":41,"line":1,"lines":[1],"start":26,"end":1899,"kind":"call","label":"canTraverseAllPairs","state":{"nums":{"$ref":"o1"},"find":{"$scalar":"undefined"},"union":{"$scalar":"undefined"}},"input":{"nums":{"$ref":"o1"}},"heap":{"o1":{"kind":"array","items":[2,3,6]}},"value":{"$scalar":"undefined"},"stack":["canTraverseAllPairs"]},{"site":0,"line":2,"lines":[2],"start":47,"end":69,"kind":"statement","label":"const n = nums.length;","state":{"nums":{"$ref":"o1"},"n":3},"input":{"nums":{"$ref":"o1"}},"heap":{},"value":{"$scalar":"undefined"},"stack":["canTraverseAllPairs"]},{"site":2,"line":5,"lines":[5],"start":97,"end":104,"kind":"check","label":"n === 1","state":{"nums":{"$ref":"o1"},"n":3},"input":{"nums":{"$ref":"o1"}},"heap":{},"value":false,"stack":["canTraverseAllPairs"]},{"site":4,"line":6,"lines":[6],"start":178,"end":194,"kind":"check","label":"nums.includes(1)","state":{"nums":{"$ref":"o1"},"n":3},"input":{"nums":{"$ref":"o1"}},"heap":{},"value":false,"stack":["canTraverseAllPairs"]},{"site":5,"line":9,"lines":[9],"start":287,"end":339,"kind":"statement","label":"const parent = Array.from({length: n}, (_, i) => i);","state":{"nums":{"$ref":"o1"},"n":3,"parent":{"$ref":"o2"}},"input":{"nums":{"$ref":"o1"}},"heap":{"o2":{"kind":"array","items":[0,1,2]}},"value":{"$scalar":"undefined"},"stack":["canTraverseAllPairs"]},{"site":16,"line":26,"lines":[26],"start":710,"end":739,"kind":"statement","label":"const primeToIdx = new Map();","state":{"nums":{"$ref":"o1"},"n":3,"parent":{"$ref":"o2"}