{"id":680,"title":"Valid Palindrome II","topic":"Two Pointers","code":"var validPalindrome = function(s) {\n    // Helper: check if s[lo..hi] is a strict palindrome (no deletions allowed)\n    const isPalindrome = (lo, hi) => {\n        while (lo < hi) {\n            if (s[lo] !== s[hi]) {\n                return false;\n            }\n            lo = lo + 1;\n            hi = hi - 1;\n        }\n        return true;\n    };\n\n    let left = 0;\n    let right = s.length - 1;\n\n    while (left < right) {\n        if (s[left] !== s[right]) {\n            // Use our one allowed deletion: try skipping left or skipping right\n            const skipLeft = isPalindrome(left + 1, right);\n            const skipRight = isPalindrome(left, right - 1);\n            return skipLeft || skipRight;\n        }\n\n        left = left + 1;\n        right = right - 1;\n    }\n\n    return true;\n};","sourceHash":"a19b3d262e7c363c3eeb488bb17846debf3ae184ecec252914492d3e1f3bc3ec","generatorHash":"d120be949580d04de09546df406ed5b5a640d1e6ded6b75fa128e96dd15f723b","fixtureHash":"5114aa52dbd56ecf0fba1f1ced78650ca8df959e042d6565ba402d46db8442b5","examples":[{"name":"Example","input":["abca"],"expected":true,"result":true,"steps":[{"site":18,"line":1,"kind":"call","label":"validPalindrome","state":{"s":"abca"},"input":{"s":"abca"},"heap":{},"value":{"$scalar":"undefined"},"stack":["validPalindrome"]},{"site":7,"line":14,"kind":"statement","label":"let left = 0;","state":{"s":"abca","left":0},"input":{"s":"abca"},"heap":{},"value":{"$scalar":"undefined"},"stack":["validPalindrome"]},{"site":8,"line":15,"kind":"statement","label":"let right = s.length - 1;","state":{"s":"abca","left":0,"right":3},"input":{"s":"abca"},"heap":{},"value":{"$scalar":"undefined"},"stack":["validPalindrome"]},{"site":16,"line":17,"kind":"check","label":"left < right","state":{"s":"abca","left":0,"right":3},"input":{"s":"abca"},"heap":{},"value":true,"stack":["validPalindrome"]},{"site":13,"line":18,"kind":"check","