{"id":680,"title":"Valid Palindrome II","topic":"Two Pointers","code":"var validPalindrome = function(s) {\n    // Helper: check if s[lo..hi] is a strict palindrome (no deletions allowed)\n    const isPalindrome = (lo, hi) => {\n        while (lo < hi) {\n            if (s[lo] !== s[hi]) {\n                return false;\n            }\n            lo = lo + 1;\n            hi = hi - 1;\n        }\n        return true;\n    };\n\n    let left = 0;\n    let right = s.length - 1;\n\n    while (left < right) {\n        if (s[left] !== s[right]) {\n            // Use our one allowed deletion: try skipping left or skipping right\n            const skipLeft = isPalindrome(left + 1, right);\n            const skipRight = isPalindrome(left, right - 1);\n            return skipLeft || skipRight;\n        }\n\n        left = left + 1;\n        right = right - 1;\n    }\n\n    return true;\n};","sourceHash":"a19b3d262e7c363c3eeb488bb17846debf3ae184ecec252914492d3e1f3bc3ec","generatorHash":"346a6be1776236e10a13a085800eed1d82b9ee73c013d4ee06a9045e463e80ed","fixtureHash":"5114aa52dbd56ecf0fba1f1ced78650ca8df959e042d6565ba402d46db8442b5","indexing":{"s":{"indices":["lo","hi","left","right"],"cells":[]}},"examples":[{"name":"Example","input":["abca"],"expected":true,"result":true,"steps":[{"site":17,"line":1,"lines":[1],"start":22,"end":793,"kind":"call","label":"validPalindrome","state":{"s":"abca"},"input":{"s":"abca"},"heap":{},"value":{"$scalar":"undefined"},"stack":["validPalindrome"]},{"site":7,"line":14,"lines":[14],"start":353,"end":366,"kind":"statement","label":"let left = 0;","state":{"s":"abca","left":0},"input":{"s":"abca"},"heap":{},"value":{"$scalar":"undefined"},"stack":["validPalindrome"]},{"site":8,"line":15,"lines":[15],"start":371,"end":396,"kind":"statement","label":"let right = s.length - 1;","state":{"s":"abca","left":0,"right":3},"input":{"s":"abca"},"heap":{},"value":{"$scalar":"undefined"},"stack":["validPalindrome"]},{"site":15,"line":17,"lines":[17],"star