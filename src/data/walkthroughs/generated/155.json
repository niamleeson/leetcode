{"id":155,"title":"Min Stack","topic":"Stack","code":"var MinStack = function() {\n    // Main stack holds the actual values\n    this.stack = [];\n    // Parallel stack where each entry is the running minimum at that level\n    this.minStack = [];\n};\n\nMinStack.prototype.push = function(val) {\n    this.stack.push(val);\n\n    // The new minimum is the smaller of val and the current minimum\n    const currentMin = this.minStack.length === 0\n        ? val\n        : this.minStack[this.minStack.length - 1];\n    const newMin = Math.min(val, currentMin);\n\n    this.minStack.push(newMin);\n};\n\nMinStack.prototype.pop = function() {\n    // Keep both stacks in sync by popping from each\n    this.stack.pop();\n    this.minStack.pop();\n};\n\nMinStack.prototype.top = function() {\n    return this.stack[this.stack.length - 1];\n};\n\nMinStack.prototype.getMin = function() {\n    // The top of minStack always holds the current minimum\n    return this.minStack[this.minStack.length - 1];\n};","sourceHash":"f09709389b7d1a6a385423ad44d9bb92dfb539ab41aafac3beeeb4271cdc1024","generatorHash":"d120be949580d04de09546df406ed5b5a640d1e6ded6b75fa128e96dd15f723b","fixtureHash":"a55aaa4a591c2f77cf4b007c47b540c4249df876c261c443b987456cfab47134","examples":[{"name":"Example","input":[],"expected":[null,null,null,null,-3,null,0,-2],"result":[null,null,null,null,-3,null,0,-2],"steps":[{"site":2,"line":1,"kind":"call","label":"MinStack","state":{},"input":{"arguments":{"$ref":"o1"}},"heap":{"o1":{"kind":"array","items":[]}},"value":{"$scalar":"undefined"},"stack":["MinStack"]},{"site":0,"line":3,"kind":"statement","label":"this.stack = [];","state":{"this":{"$ref":"o2"}},"input":{"arguments":{"$ref":"o1"}},"heap":{"o2":{"kind":"object","fields":{"stack":{"$ref":"o3"}}},"o3":{"kind":"array","items":[]}},"value":{"$scalar":"undefined"},"stack":["MinStack"]},{"site":1,"line":5,"kind":"statement","label":"this.minStack = [];","state":{"this":{"$ref":"o2"}},"input":{"arguments":{"$ref":"o1"}