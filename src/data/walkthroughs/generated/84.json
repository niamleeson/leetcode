{"id":84,"title":"Largest Rectangle In Histogram","topic":"Stack","code":"var largestRectangleArea = function(heights) {\n    const stack = [];  // stores [leftEdge, height] pairs\n    let maxArea = 0;\n\n    // Sentinel 0 at end forces all remaining bars to be popped\n    heights.push(0);\n\n    for (let i = 0; i < heights.length; i++) {\n        let leftEdge = i;\n\n        while (stack.length > 0) {\n            const [topLeft, topHeight] = stack[stack.length - 1];\n            if (topHeight <= heights[i]) {\n                break;\n            }\n\n            const width = i - topLeft;\n            maxArea = Math.max(maxArea, topHeight * width);\n            leftEdge = topLeft;\n            stack.pop();\n        }\n\n        stack.push([leftEdge, heights[i]]);\n    }\n\n    // Remove the sentinel we added\n    heights.pop();\n\n    return maxArea;\n};","sourceHash":"85fe6af1c96e0276f1e49a8415718f32c81953aff757c7406bb9c9c87d4037ee","generatorHash":"d120be949580d04de09546df406ed5b5a640d1e6ded6b75fa128e96dd15f723b","fixtureHash":"7b509bbfdb6355a5acdd321f61e6da44a70a5ee0db9fe3ae8df0cd0e7fcd6230","examples":[{"name":"Example","input":[[2,1,5,6,2,3]],"expected":10,"result":10,"steps":[{"site":21,"line":1,"kind":"call","label":"largestRectangleArea","state":{"heights":{"$ref":"o1"}},"input":{"heights":{"$ref":"o1"}},"heap":{"o1":{"kind":"array","items":[2,1,5,6,2,3]}},"value":{"$scalar":"undefined"},"stack":["largestRectangleArea"]},{"site":0,"line":2,"kind":"statement","label":"const stack = [];","state":{"heights":{"$ref":"o1"},"stack":{"$ref":"o2"}},"input":{"heights":{"$ref":"o1"}},"heap":{"o2":{"kind":"array","items":[]}},"value":{"$scalar":"undefined"},"stack":["largestRectangleArea"]},{"site":1,"line":3,"kind":"statement","label":"let maxArea = 0;","state":{"heights":{"$ref":"o1"},"stack":{"$ref":"o2"},"maxArea":0},"input":{"heights":{"$ref":"o1"}},"heap":{},"value":{"$scalar":"undefined"},"stack":["largestRectangleArea"]},{"site":2,"line":6,"kind":"operation",