{"id":19,"title":"Remove Nth Node From End of List","topic":"Linked List","code":"var removeNthFromEnd = function(head, n) {\n    // Dummy node before head handles removing the first node gracefully\n    const dummy = new ListNode(0, head);\n    let fast = dummy;\n    let slow = dummy;\n\n    // Advance fast by n+1 steps so that the gap between slow and fast is n+1\n    for (let i = 0; i < n + 1; i++) {\n        fast = fast.next;\n    }\n\n    // Move both pointers together until fast falls off the end\n    while (fast) {\n        fast = fast.next;\n        slow = slow.next;\n    }\n\n    // slow is now just before the node to remove; skip over it\n    slow.next = slow.next.next;\n\n    return dummy.next;\n};","sourceHash":"3aee3f5108719c74539018973738e71c9e8497096300a1e3baa0e9000a1db4a4","generatorHash":"b66120ae1d9d0cfc0bba45cf6f5673ac49a7d0cba8100ee7e720869b46fddc24","fixtureHash":"f5274c571035b75eb7db0cd2420283471cc53a2c15fb65d63d300ce4a29ddb77","indexing":{},"examples":[{"name":"Example","input":[{"$list":[1,2,3,4,5]},2],"expected":[1,2,3,5],"result":[1,2,3,5],"steps":[{"site":11,"line":1,"lines":[1],"start":23,"end":614,"kind":"call","label":"removeNthFromEnd","state":{"head":{"$ref":"o1"},"n":2},"input":{"head":{"$ref":"o1"},"n":2},"heap":{"o1":{"kind":"list","fields":{"val":1,"next":{"$ref":"o2"}}},"o2":{"kind":"list","fields":{"val":2,"next":{"$ref":"o3"}}},"o3":{"kind":"list","fields":{"val":3,"next":{"$ref":"o4"}}},"o4":{"kind":"list","fields":{"val":4,"next":{"$ref":"o5"}}},"o5":{"kind":"list","fields":{"val":5,"next":null}}},"value":{"$scalar":"undefined"},"stack":["removeNthFromEnd"]},{"site":0,"line":3,"lines":[3],"start":120,"end":156,"kind":"statement","label":"const dummy = new ListNode(0, head);","state":{"head":{"$ref":"o1"},"n":2,"dummy":{"$ref":"o6"}},"input":{"head":{"$ref":"o1"},"n":2},"heap":{"o6":{"kind":"list","fields":{"val":0,"next":{"$ref":"o1"}}}},"value":{"$scalar":"undefined"},"stack":["removeNthFromEnd"]},{"site":1,"line":4,"lines":