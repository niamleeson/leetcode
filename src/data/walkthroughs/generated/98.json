{"id":98,"title":"Validate Binary Search Tree","topic":"Trees","code":"var isValidBST = function(root) {\n    const validate = (node, low, high) => {\n        // An empty node is trivially valid\n        if (!node) {\n            return true;\n        }\n\n        // The node's value must be strictly within the allowed range\n        if (node.val <= low || node.val >= high) {\n            return false;\n        }\n\n        // Going left: the current node's value becomes the new upper bound\n        // Going right: the current node's value becomes the new lower bound\n        const leftIsValid = validate(node.left, low, node.val);\n        const rightIsValid = validate(node.right, node.val, high);\n\n        return leftIsValid && rightIsValid;\n    };\n\n    return validate(root, -Infinity, Infinity);\n};","sourceHash":"12951c4c721218cfa7641ec6f562a62d74ee3401ad5ba01abc42eef6e4b028e4","generatorHash":"b66120ae1d9d0cfc0bba45cf6f5673ac49a7d0cba8100ee7e720869b46fddc24","fixtureHash":"a4324f13f45b07c8c714c5bc512756fc42b21c73dadd886efb2b785b9da8e229","indexing":{},"examples":[{"name":"Example","input":[{"$tree":[5,1,4,null,null,3,6]}],"expected":false,"result":false,"steps":[{"site":11,"line":1,"lines":[1],"start":17,"end":723,"kind":"call","label":"isValidBST","state":{"root":{"$ref":"o1"}},"input":{"root":{"$ref":"o1"}},"heap":{"o1":{"kind":"tree","fields":{"val":5,"left":{"$ref":"o2"},"right":{"$ref":"o3"}}},"o2":{"kind":"tree","fields":{"val":1,"left":null,"right":null}},"o3":{"kind":"tree","fields":{"val":4,"left":{"$ref":"o4"},"right":{"$ref":"o5"}}},"o4":{"kind":"tree","fields":{"val":3,"left":null,"right":null}},"o5":{"kind":"tree","fields":{"val":6,"left":null,"right":null}}},"value":{"$scalar":"undefined"},"stack":["isValidBST"]},{"site":9,"line":2,"lines":[2],"start":55,"end":671,"kind":"call","label":"validate","state":{"node":{"$ref":"o1"},"low":{"$scalar":"-Infinity"},"high":{"$scalar":"Infinity"},"root":{"$ref":"o1"}},"input":{"root":{"$ref":"o1"}},"heap":