{"id":735,"title":"Asteroid Collision","topic":"Stack","code":"var asteroidCollision = function(asteroids) {\n    const stack = [];\n\n    for (const asteroid of asteroids) {\n        let alive = true;\n\n        // Collision only possible: current goes left (negative) AND stack top goes right (positive)\n        while (alive && asteroid < 0 && stack.length > 0 && stack[stack.length - 1] > 0) {\n            const topAsteroid = stack[stack.length - 1];\n            const incomingSize = -asteroid; // absolute size of the left-moving asteroid\n\n            if (topAsteroid < incomingSize) {\n                // Stack top is smaller — it gets destroyed, keep fighting\n                stack.pop();\n            } else if (topAsteroid === incomingSize) {\n                // Equal size — both are destroyed\n                stack.pop();\n                alive = false;\n            } else {\n                // Stack top is larger — incoming asteroid is destroyed\n                alive = false;\n            }\n        }\n\n        if (alive) {\n            stack.push(asteroid);\n        }\n    }\n\n    return stack;\n};","sourceHash":"1270585a27ffcf6ab5b926e0f1a0b18968c0801869ee99a8bf9864acb2165e77","generatorHash":"b66120ae1d9d0cfc0bba45cf6f5673ac49a7d0cba8100ee7e720869b46fddc24","fixtureHash":"6d4a96cfb50d1ed1a7b9685c07902cab7f1c3c8af81e411e5375a60983e75412","indexing":{},"examples":[{"name":"Example","input":[[5,10,-5]],"expected":[5,10],"result":[5,10],"steps":[{"site":22,"line":1,"lines":[1],"start":24,"end":1031,"kind":"call","label":"asteroidCollision","state":{"asteroids":{"$ref":"o1"}},"input":{"asteroids":{"$ref":"o1"}},"heap":{"o1":{"kind":"array","items":[5,10,-5]}},"value":{"$scalar":"undefined"},"stack":["asteroidCollision"]},{"site":0,"line":2,"lines":[2],"start":50,"end":67,"kind":"statement","label":"const stack = [];","state":{"asteroids":{"$ref":"o1"},"stack":{"$ref":"o2"}},"input":{"asteroids":{"$ref":"o1"}},"heap":{"o2":{"kind":"array","items":[]}},"value":