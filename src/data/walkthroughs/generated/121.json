{"id":121,"title":"Best Time to Buy And Sell Stock","topic":"Sliding Window","code":"var maxProfit = function(prices) {\n    // Track the cheapest buy price seen so far\n    let minPrice = Infinity;\n\n    // Track the best profit achievable so far\n    let maxProfit = 0;\n\n    for (const price of prices) {\n        // Update the cheapest price we could have bought at\n        if (price < minPrice) {\n            minPrice = price;\n        }\n\n        // If we sold today, what would our profit be?\n        const profitIfSoldToday = price - minPrice;\n\n        // Update best profit if today's potential profit is better\n        if (profitIfSoldToday > maxProfit) {\n            maxProfit = profitIfSoldToday;\n        }\n    }\n\n    return maxProfit;\n};","sourceHash":"030608f5ff6b5b351d5e0bb29d4a6e16e53271a0ee117e47413a23cda5e63994","generatorHash":"346a6be1776236e10a13a085800eed1d82b9ee73c013d4ee06a9045e463e80ed","fixtureHash":"68e0cde0aa47aee83ecb793e255259514b02fc02af38b71fdcf9dad6b750946e","indexing":{},"examples":[{"name":"Example","input":[[7,1,5,3,6,4]],"expected":5,"result":5,"steps":[{"site":10,"line":1,"lines":[1],"start":16,"end":656,"kind":"call","label":"maxProfit","state":{"prices":{"$ref":"o1"}},"input":{"prices":{"$ref":"o1"}},"heap":{"o1":{"kind":"array","items":[7,1,5,3,6,4]}},"value":{"$scalar":"undefined"},"stack":["maxProfit"]},{"site":0,"line":3,"lines":[3],"start":87,"end":111,"kind":"statement","label":"let minPrice = Infinity;","state":{"prices":{"$ref":"o1"},"minPrice":{"$scalar":"Infinity"}},"input":{"prices":{"$ref":"o1"}},"heap":{},"value":{"$scalar":"undefined"},"stack":["maxProfit"]},{"site":1,"line":6,"lines":[6],"start":164,"end":182,"kind":"statement","label":"let maxProfit = 0;","state":{"prices":{"$ref":"o1"},"minPrice":{"$scalar":"Infinity"},"maxProfit":0},"input":{"prices":{"$ref":"o1"}},"heap":{},"value":{"$scalar":"undefined"},"stack":["maxProfit"]},{"site":7,"line":8,"lines":[8],"start":188,"end":631,"kind":"iterate","label