{"id":787,"title":"Cheapest Flights Within K Stops","topic":"Advanced Graphs","code":"var findCheapestPrice = function(n, flights, src, dst, k) {\n    const INF = Infinity;\n\n    // prices[i] = cheapest cost to reach city i from src\n    // Initialize src to 0, all others to infinity (unreachable)\n    let prices = new Array(n).fill(INF);\n    prices[src] = 0;\n\n    // Run exactly k+1 rounds: k stops = at most k+1 flights used\n    for (let round = 0; round < k + 1; round++) {\n        // Work from a snapshot of last round's prices\n        // This prevents chaining updates within a single round\n        const temp = [...prices];\n\n        for (const [from, to, cost] of flights) {\n            // Can only use this flight if we can reach 'from'\n            if (prices[from] !== INF) {\n                const newCost = prices[from] + cost;\n\n                // Update temp (not prices) to stay within the stop limit\n                if (newCost < temp[to]) {\n                    temp[to] = newCost;\n                }\n            }\n        }\n\n        // Move to next round\n        prices = temp;\n    }\n\n    return prices[dst] !== INF ? prices[dst] : -1;\n};","sourceHash":"4061ed6f922a7aa4af898fbb88f7c201c5abb7464402b51b43a15016a1e1d876","generatorHash":"d120be949580d04de09546df406ed5b5a640d1e6ded6b75fa128e96dd15f723b","fixtureHash":"a94e3eecd07cce2b942b34ec7a643821ae55d905448fd4b6230ed321b2f1b22f","examples":[{"name":"Example","input":[4,[[0,1,100],[1,2,100],[2,0,100],[1,3,600],[2,3,200]],0,3,1],"expected":700,"result":700,"steps":[{"site":16,"line":1,"kind":"call","label":"findCheapestPrice","state":{"n":4,"flights":{"$ref":"o1"},"src":0,"dst":3,"k":1},"input":{"n":4,"flights":{"$ref":"o1"},"src":0,"dst":3,"k":1},"heap":{"o1":{"kind":"array","items":[{"$ref":"o2"},{"$ref":"o3"},{"$ref":"o4"},{"$ref":"o5"},{"$ref":"o6"}]},"o2":{"kind":"array","items":[0,1,100]},"o3":{"kind":"array","items":[1,2,100]},"o4":{"kind":"array","items":[2,0,100]},"o5":{"kind":"array","