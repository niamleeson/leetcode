{"id":191,"title":"Number of 1 Bits","topic":"Bit Manipulation","code":"var hammingWeight = function(n) {\n    let count = 0;\n\n    while (n !== 0) {\n        // n & (n - 1) clears the lowest set bit of n\n        // Subtracting 1 turns the lowest 1-bit into 0 and flips all lower bits\n        // ANDing with n restores everything above that bit and zeros everything at or below\n        n = n & (n - 1);\n\n        // We just eliminated one set bit, so increment the count\n        count++;\n    }\n\n    return count;\n};","sourceHash":"35d1b8e845604130821da6f6ea0d40b2f609a61358491996e58a291054f0246b","generatorHash":"d120be949580d04de09546df406ed5b5a640d1e6ded6b75fa128e96dd15f723b","fixtureHash":"5d391025004e1653c07cb273ea761261d68bbbcdec1e0ba31e7a752868ff567b","examples":[{"name":"Example","input":[11],"expected":3,"result":3,"steps":[{"site":5,"line":1,"kind":"call","label":"hammingWeight","state":{"n":11},"input":{"n":11},"heap":{},"value":{"$scalar":"undefined"},"stack":["hammingWeight"]},{"site":0,"line":2,"kind":"statement","label":"let count = 0;","state":{"n":11,"count":0},"input":{"n":11},"heap":{},"value":{"$scalar":"undefined"},"stack":["hammingWeight"]},{"site":3,"line":4,"kind":"check","label":"n !== 0","state":{"n":11,"count":0},"input":{"n":11},"heap":{},"value":true,"stack":["hammingWeight"]},{"site":1,"line":8,"kind":"statement","label":"n = n & (n - 1);","state":{"n":10,"count":0},"input":{"n":11},"heap":{},"value":{"$scalar":"undefined"},"stack":["hammingWeight"]},{"site":2,"line":11,"kind":"statement","label":"count++;","state":{"n":10,"count":1},"input":{"n":11},"heap":{},"value":{"$scalar":"undefined"},"stack":["hammingWeight"]},{"site":3,"line":4,"kind":"check","label":"n !== 0","state":{"n":10,"count":1},"input":{"n":11},"heap":{},"value":true,"stack":["hammingWeight"]},{"site":1,"line":8,"kind":"statement","label":"n = n & (n - 1);","state":{"n":8,"count":1},"input":{"n":11},"heap":{},"value":{"$scalar":"undefined"},"stack":["hammingWeight"]}