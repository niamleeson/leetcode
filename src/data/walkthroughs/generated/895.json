{"id":895,"title":"Maximum Frequency Stack","topic":"Stack","code":"var FreqStack = function() {\n    this.freq = new Map();    // val -> current frequency\n    this.group = new Map();   // frequency -> stack of values with that frequency\n    this.maxFreq = 0;         // current maximum frequency\n};\n\nFreqStack.prototype.push = function(val) {\n    // Increment this value's frequency\n    const newFreq = (this.freq.get(val) || 0) + 1;\n    this.freq.set(val, newFreq);\n\n    // Update max frequency\n    if (newFreq > this.maxFreq) {\n        this.maxFreq = newFreq;\n    }\n\n    // Push val onto the stack for its new frequency level\n    if (!this.group.has(newFreq)) this.group.set(newFreq, []);\n    this.group.get(newFreq).push(val);\n};\n\nFreqStack.prototype.pop = function() {\n    // Pop from the highest frequency stack (LIFO breaks ties)\n    const val = this.group.get(this.maxFreq).pop();\n\n    // Decrease this value's frequency\n    this.freq.set(val, this.freq.get(val) - 1);\n\n    // If the top frequency stack is now empty, decrease maxFreq\n    if (this.group.get(this.maxFreq).length === 0) {\n        this.maxFreq--;\n    }\n\n    return val;\n};","sourceHash":"29ce4be6a74a92077a582037a41207c6be03c691e2a30f3d1b080dcadce509a1","generatorHash":"346a6be1776236e10a13a085800eed1d82b9ee73c013d4ee06a9045e463e80ed","fixtureHash":"8225d8fbcabb12ff8287e7bb011b628054b412c682795659ac52ca8beefa4fcc","indexing":{},"examples":[{"name":"Example","input":[],"expected":[null,null,null,null,null,null,null,5,7,5,4],"result":[null,null,null,null,null,null,null,5,7,5,4],"steps":[{"site":3,"line":1,"lines":[1],"start":16,"end":229,"kind":"call","label":"FreqStack","state":{},"input":{"arguments":{"$ref":"o1"}},"heap":{"o1":{"kind":"array","items":[]}},"value":{"$scalar":"undefined"},"stack":["FreqStack"]},{"site":0,"line":2,"lines":[2],"start":33,"end":55,"kind":"statement","label":"this.freq = new Map();","state":{"this":{"$ref":"o2"}},"input":{"arguments":{"$ref":"o1"}},"h