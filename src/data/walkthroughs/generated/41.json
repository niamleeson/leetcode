{"id":41,"title":"First Missing Positive","topic":"Arrays & Hashing","code":"var firstMissingPositive = function(nums) {\n    const n = nums.length;\n\n    // Cyclic sort: put each value v at index v-1\n    for (let i = 0; i < n; i++) {\n        // Keep swapping until nums[i] is in the right place or out of range\n        while (nums[i] >= 1 && nums[i] <= n) {\n            const correctIndex = nums[i] - 1;\n\n            // Already in the right spot (also handles duplicates)\n            if (nums[correctIndex] === nums[i]) {\n                break;\n            }\n\n            // Swap nums[i] to its correct position\n            const temp = nums[i];\n            nums[i] = nums[correctIndex];\n            nums[correctIndex] = temp;\n        }\n    }\n\n    // Scan for the first slot where the value doesn't match\n    for (let i = 0; i < n; i++) {\n        if (nums[i] !== i + 1) {\n            return i + 1;\n        }\n    }\n\n    // All 1..n are present\n    return n + 1;\n};","sourceHash":"743d44859f1dfa9babf25f2c798c6e8c6217ab35342e0d8ec7cc271b88b3d210","generatorHash":"346a6be1776236e10a13a085800eed1d82b9ee73c013d4ee06a9045e463e80ed","fixtureHash":"cad4e70afcbe40d7256a55e723371f5fc4ffc0344375a6676dde6ff65cf7ccd1","indexing":{"nums":{"indices":["i","correctIndex"],"cells":[]}},"examples":[{"name":"Example","input":[[3,4,-1,1]],"expected":2,"result":2,"steps":[{"site":15,"line":1,"lines":[1],"start":27,"end":884,"kind":"call","label":"firstMissingPositive","state":{"nums":{"$ref":"o1"}},"input":{"nums":{"$ref":"o1"}},"heap":{"o1":{"kind":"array","items":[3,4,-1,1]}},"value":{"$scalar":"undefined"},"stack":["firstMissingPositive"]},{"site":0,"line":2,"lines":[2],"start":48,"end":70,"kind":"statement","label":"const n = nums.length;","state":{"nums":{"$ref":"o1"},"n":4},"input":{"nums":{"$ref":"o1"}},"heap":{},"value":{"$scalar":"undefined"},"stack":["firstMissingPositive"]},{"site":8,"line":5,"lines":[5],"start":142,"end":147,"kind":"check","label":"i < n","state"