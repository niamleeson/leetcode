{"id":978,"title":"Longest Turbulent Subarray","topic":"Greedy","code":"var maxTurbulenceSize = function(arr) {\n    const n = arr.length;\n    if (n === 1) return 1;\n\n    // inc: length of turbulent subarray ending at current position where arr[i] > arr[i-1]\n    // dec: length of turbulent subarray ending at current position where arr[i] < arr[i-1]\n    let inc = 1;\n    let dec = 1;\n    let maxLen = 1;\n\n    for (let i = 1; i < n; i++) {\n        if (arr[i] > arr[i - 1]) {\n            // Current is greater — extends a subarray that was previously decreasing\n            inc = dec + 1;\n            dec = 1; // Reset: a \"decreasing ending\" cannot extend with an increase\n        } else if (arr[i] < arr[i - 1]) {\n            // Current is less — extends a subarray that was previously increasing\n            dec = inc + 1;\n            inc = 1; // Reset\n        } else {\n            // Equal: breaks turbulence entirely\n            inc = 1;\n            dec = 1;\n        }\n\n        maxLen = Math.max(maxLen, inc, dec);\n    }\n\n    return maxLen;\n};","sourceHash":"0ef14b27df096775f10a563835aab3809fe909f60af9b9cafa3e7eb1ccbbe947","generatorHash":"346a6be1776236e10a13a085800eed1d82b9ee73c013d4ee06a9045e463e80ed","fixtureHash":"d4ecdb3c47af89d5538b110703fefb9e6131ec7175d960eaddb3a86a26988e2b","indexing":{"arr":{"indices":["i"],"cells":[]}},"examples":[{"name":"Example","input":[[9,4,2,10,7,8,8,1,9]],"expected":5,"result":5,"steps":[{"site":18,"line":1,"lines":[1],"start":24,"end":972,"kind":"call","label":"maxTurbulenceSize","state":{"arr":{"$ref":"o1"}},"input":{"arr":{"$ref":"o1"}},"heap":{"o1":{"kind":"array","items":[9,4,2,10,7,8,8,1,9]}},"value":{"$scalar":"undefined"},"stack":["maxTurbulenceSize"]},{"site":0,"line":2,"lines":[2],"start":44,"end":65,"kind":"statement","label":"const n = arr.length;","state":{"arr":{"$ref":"o1"},"n":9},"input":{"arr":{"$ref":"o1"}},"heap":{},"value":{"$scalar":"undefined"},"stack":["maxTurbulenceSize"]},{"site":2,"line":