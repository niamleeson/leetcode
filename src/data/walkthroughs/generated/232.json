{"id":232,"title":"Implement Queue using Stacks","topic":"Stack","code":"var MyQueue = function() {\n    // New elements always arrive here\n    this.inputStack = [];\n    // Elements in FIFO order (oldest on top) for dequeue\n    this.outputStack = [];\n};\n\nMyQueue.prototype.push = function(x) {\n    // Always push to input stack — O(1)\n    this.inputStack.push(x);\n};\n\nMyQueue.prototype.pop = function() {\n    // Ensure outputStack has elements, then remove the oldest\n    this._transfer();\n    return this.outputStack.pop();\n};\n\nMyQueue.prototype.peek = function() {\n    // Ensure outputStack has elements, then read the oldest\n    this._transfer();\n    return this.outputStack[this.outputStack.length - 1];\n};\n\nMyQueue.prototype.empty = function() {\n    const inputIsEmpty = this.inputStack.length === 0;\n    const outputIsEmpty = this.outputStack.length === 0;\n    return inputIsEmpty && outputIsEmpty;\n};\n\nMyQueue.prototype._transfer = function() {\n    // Only transfer when outputStack is empty — each element moves at most once\n    if (this.outputStack.length === 0) {\n        while (this.inputStack.length > 0) {\n            const topOfInput = this.inputStack.pop();\n            this.outputStack.push(topOfInput);\n        }\n    }\n};","sourceHash":"a57b26a346f37336cc9f34ad6cd4f7e2f3f0ee478a927ff0cfefc6a104d4e348","generatorHash":"d120be949580d04de09546df406ed5b5a640d1e6ded6b75fa128e96dd15f723b","fixtureHash":"760871e4af8132c085864159a29b4df6b57e2bc3ee435d1bfc7f81506d255ff0","examples":[{"name":"Example","input":[],"expected":[null,null,null,1,1,false],"result":[null,null,null,1,1,false],"steps":[{"site":2,"line":1,"kind":"call","label":"MyQueue","state":{},"input":{"arguments":{"$ref":"o1"}},"heap":{"o1":{"kind":"array","items":[]}},"value":{"$scalar":"undefined"},"stack":["MyQueue"]},{"site":0,"line":3,"kind":"statement","label":"this.inputStack = [];","state":{"this":{"$ref":"o2"}},"input":{"arguments":{"$ref":"o1"}},"heap":{"o2":{"kind":"obj