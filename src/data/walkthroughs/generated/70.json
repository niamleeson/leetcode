{"id":70,"title":"Climbing Stairs","topic":"1-D Dynamic Programming","code":"var climbStairs = function(n) {\n    // one = ways to reach the \"current\" step\n    // two = ways to reach the \"previous\" step\n    // Both start at 1 (base cases: 1 way to reach step 1 or step 0)\n    let one = 1;\n    let two = 1;\n\n    // We iterate n-1 times to build up from step 1 to step n\n    for (let i = 0; i < n - 1; i++) {\n        // Save current value before overwriting\n        const temp = one;\n\n        // Ways to reach the next step = ways from one step below + two steps below\n        one = one + two;\n\n        // Shift: previous \"one\" becomes the new \"two\"\n        two = temp;\n    }\n\n    // \"one\" now holds the number of ways to reach step n\n    return one;\n};","sourceHash":"cb91f35e4c30e769b7fbd9e011a420b4f5ec7df557c53af73b9f12f43f8f19de","generatorHash":"d120be949580d04de09546df406ed5b5a640d1e6ded6b75fa128e96dd15f723b","fixtureHash":"03376ae7777d9878491648d6c5eaa6757661d9eabfae6e77adf31507ff6c391b","examples":[{"name":"Example","input":[2],"expected":2,"result":2,"steps":[{"site":8,"line":1,"kind":"call","label":"climbStairs","state":{"n":2},"input":{"n":2},"heap":{},"value":{"$scalar":"undefined"},"stack":["climbStairs"]},{"site":0,"line":5,"kind":"statement","label":"let one = 1;","state":{"n":2,"one":1},"input":{"n":2},"heap":{},"value":{"$scalar":"undefined"},"stack":["climbStairs"]},{"site":1,"line":6,"kind":"statement","label":"let two = 1;","state":{"n":2,"one":1,"two":1},"input":{"n":2},"heap":{},"value":{"$scalar":"undefined"},"stack":["climbStairs"]},{"site":5,"line":9,"kind":"check","label":"i < n - 1","state":{"i":0,"n":2,"one":1,"two":1},"input":{"n":2},"heap":{},"value":true,"stack":["climbStairs"]},{"site":2,"line":11,"kind":"statement","label":"const temp = one;","state":{"temp":1,"i":0,"n":2,"one":1,"two":1},"input":{"n":2},"heap":{},"value":{"$scalar":"undefined"},"stack":["climbStairs"]},{"site":3,"line":14,"kind":"statement","label":