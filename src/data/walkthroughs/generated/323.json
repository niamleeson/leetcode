{"id":323,"title":"Number of Connected Components In An Undirected Graph","topic":"Graphs","code":"var countComponents = function(n, edges) {\n    // Initialize Union-Find: each node is its own root\n    const parent = Array(n)\n        .fill(null)\n        .map((_, i) => i);\n\n    // Find root with path compression (flattens tree for speed)\n    const find = (x) => {\n        while (parent[x] !== x) {\n            parent[x] = parent[parent[x]]; // path compression: skip to grandparent\n            x = parent[x];\n        }\n        return x;\n    };\n\n    // Start with n separate components\n    let componentCount = n;\n\n    for (const [u, v] of edges) {\n        const rootU = find(u);\n        const rootV = find(v);\n\n        // Only merge if they belong to different components\n        if (rootU !== rootV) {\n            parent[rootU] = rootV;\n            componentCount--;\n        }\n    }\n\n    return componentCount;\n};","sourceHash":"a8422dc4188c58b97f49ffcb713a7a0ed06de776247ff256bb9247fec8757250","generatorHash":"346a6be1776236e10a13a085800eed1d82b9ee73c013d4ee06a9045e463e80ed","fixtureHash":"b4bf69efc58e2539a28d9cb76e62d1af11b8ac64cf5c7521f7ef4bb7ceb61dbe","indexing":{"parent":{"indices":["x","rootU"],"cells":[]}},"examples":[{"name":"Example","input":[5,[[0,1],[1,2],[3,4]]],"expected":2,"result":2,"steps":[{"site":16,"line":1,"lines":[1],"start":22,"end":815,"kind":"call","label":"countComponents","state":{"n":5,"edges":{"$ref":"o1"}},"input":{"n":5,"edges":{"$ref":"o1"}},"heap":{"o1":{"kind":"array","items":[{"$ref":"o2"},{"$ref":"o3"},{"$ref":"o4"}]},"o2":{"kind":"array","items":[0,1]},"o3":{"kind":"array","items":[1,2]},"o4":{"kind":"array","items":[3,4]}},"value":{"$scalar":"undefined"},"stack":["countComponents"]},{"site":0,"line":3,"lines":[3,4],"start":118,"end":146,"kind":"operation","label":"Array(n) .fill(null)","state":{"n":5,"edges":{"$ref":"o1"}},"input":{"n":5,"edges":{"$ref":"o1"}},"heap":{"o5":{"kind":"array","items":[null,null,null,