{"id":682,"title":"Baseball Game","topic":"Stack","code":"var calPoints = function(operations) {\n    // Stack holds the current list of valid scores\n    const scoreStack = [];\n\n    for (const operation of operations) {\n        if (operation === 'C') {\n            // Cancel: remove the last valid score\n            scoreStack.pop();\n        } else if (operation === 'D') {\n            // Double: add a score that is double the most recent score\n            const mostRecentScore = scoreStack[scoreStack.length - 1];\n            scoreStack.push(mostRecentScore * 2);\n        } else if (operation === '+') {\n            // Plus: add a score that is the sum of the last two scores\n            const lastScore = scoreStack[scoreStack.length - 1];\n            const secondLastScore = scoreStack[scoreStack.length - 2];\n            scoreStack.push(lastScore + secondLastScore);\n        } else {\n            // Numeric string: record this as a new score\n            scoreStack.push(parseInt(operation));\n        }\n    }\n\n    // Sum all remaining valid scores\n    return scoreStack.reduce((total, score) => total + score, 0);\n};","sourceHash":"2a9a6c4c76494ed843b0f8fa23e07e6273fe85e58f78766dd6875a100ec42bd5","generatorHash":"d120be949580d04de09546df406ed5b5a640d1e6ded6b75fa128e96dd15f723b","fixtureHash":"43164ca1332f358d3408e98e32525a4fbf7ae09dae4ed577217747da6afc893d","examples":[{"name":"Example","input":[["5","2","C","D","+"]],"expected":30,"result":30,"steps":[{"site":18,"line":1,"kind":"call","label":"calPoints","state":{"operations":{"$ref":"o1"}},"input":{"operations":{"$ref":"o1"}},"heap":{"o1":{"kind":"array","items":["5","2","C","D","+"]}},"value":{"$scalar":"undefined"},"stack":["calPoints"]},{"site":0,"line":3,"kind":"statement","label":"const scoreStack = [];","state":{"operations":{"$ref":"o1"},"scoreStack":{"$ref":"o2"}},"input":{"operations":{"$ref":"o1"}},"heap":{"o2":{"kind":"array","items":[]}},"value":{"$scalar":"undefined"},"stack":["calPoints"]}