{"id":219,"title":"Contains Duplicate II","topic":"Sliding Window","code":"var containsNearbyDuplicate = function(nums, k) {\n    // Sliding window of at most k elements\n    const window = new Set();\n\n    for (let i = 0; i < nums.length; i = i + 1) {\n        const currentNum = nums[i];\n\n        // If current number is already in window, indices are within distance k\n        if (window.has(currentNum)) {\n            return true;\n        }\n\n        // Add current number to window\n        window.add(currentNum);\n\n        // Keep window size at most k by removing the element that fell out\n        if (window.size > k) {\n            const oldestNum = nums[i - k];\n            window.delete(oldestNum);\n        }\n    }\n\n    return false;\n};","sourceHash":"927e9a28f1676aae9880f7a08bad7b8fa32e4b05f1ffd6905a18b533a896fb9d","generatorHash":"346a6be1776236e10a13a085800eed1d82b9ee73c013d4ee06a9045e463e80ed","fixtureHash":"6f7769d07db675930a92e21490e81289b30881e2c12b173df403efd27eefa163","indexing":{"nums":{"indices":["i"],"cells":[]}},"examples":[{"name":"Example","input":[[1,2,3,1],3],"expected":true,"result":true,"steps":[{"site":11,"line":1,"lines":[1],"start":30,"end":664,"kind":"call","label":"containsNearbyDuplicate","state":{"nums":{"$ref":"o1"},"k":3},"input":{"nums":{"$ref":"o1"},"k":3},"heap":{"o1":{"kind":"array","items":[1,2,3,1]}},"value":{"$scalar":"undefined"},"stack":["containsNearbyDuplicate"]},{"site":0,"line":3,"lines":[3],"start":98,"end":123,"kind":"statement","label":"const window = new Set();","state":{"nums":{"$ref":"o1"},"k":3,"window":{"$ref":"o2"}},"input":{"nums":{"$ref":"o1"},"k":3},"heap":{"o2":{"kind":"set","items":[]}},"value":{"$scalar":"undefined"},"stack":["containsNearbyDuplicate"]},{"site":8,"line":5,"lines":[5],"start":145,"end":160,"kind":"check","label":"i < nums.length","state":{"i":0,"nums":{"$ref":"o1"},"k":3,"window":{"$ref":"o2"}},"input":{"nums":{"$ref":"o1"},"k":3},"heap":{},"value":true,"stack":["containsNearbyD