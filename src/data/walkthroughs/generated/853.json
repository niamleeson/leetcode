{"id":853,"title":"Car Fleet","topic":"Stack","code":"var carFleet = function(target, position, speed) {\n    // Pair each car's position with its speed, then sort closest-to-target first\n    const cars = position\n        .map((pos, i) => [pos, speed[i]])\n        .sort((a, b) => b[0] - a[0]);\n\n    // Stack holds arrival times of each distinct fleet\n    const stack = [];\n\n    for (const [pos, spd] of cars) {\n        // Time for this car to reach the target on its own\n        const timeToTarget = (target - pos) / spd;\n\n        const stackTop = stack[stack.length - 1];\n        const formsNewFleet = !stack.length || timeToTarget > stackTop;\n\n        if (formsNewFleet) {\n            // This car is slower than the fleet ahead — it leads its own fleet\n            stack.push(timeToTarget);\n        }\n        // Otherwise this car catches up to the fleet ahead and merges — do nothing\n    }\n\n    return stack.length;\n};","sourceHash":"bc7df561e5fb0a9f70d7abb9952b6977477c1b1264ec2b51801b256366ad2fc4","generatorHash":"d120be949580d04de09546df406ed5b5a640d1e6ded6b75fa128e96dd15f723b","fixtureHash":"7c5f64070b3ce59055872d2089be86c564af12cf57444ebdce49feb03343328c","examples":[{"name":"Example","input":[12,[10,8,0,5,3],[2,4,1,1,3]],"expected":3,"result":3,"steps":[{"site":13,"line":1,"kind":"call","label":"carFleet","state":{"target":12,"position":{"$ref":"o1"},"speed":{"$ref":"o2"}},"input":{"target":12,"position":{"$ref":"o1"},"speed":{"$ref":"o2"}},"heap":{"o1":{"kind":"array","items":[10,8,0,5,3]},"o2":{"kind":"array","items":[2,4,1,1,3]}},"value":{"$scalar":"undefined"},"stack":["carFleet"]},{"site":0,"line":3,"kind":"operation","label":"position .map((pos, i) => [pos, speed[i]]) .sort((a, b) => b[0] - a[0])","state":{"target":12,"position":{"$ref":"o1"},"speed":{"$ref":"o2"}},"input":{"target":12,"position":{"$ref":"o1"},"speed":{"$ref":"o2"}},"heap":{"o3":{"kind":"array","items":[{"$ref":"o4"},{"$ref":"o5"},{"$ref":"o6"},{"$ref":"o7"},{"$ref":"o8"}]},"o