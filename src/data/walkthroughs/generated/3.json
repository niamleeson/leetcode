{"id":3,"title":"Longest Substring Without Repeating Characters","topic":"Sliding Window","code":"var lengthOfLongestSubstring = function(s) {\n    // Set holds all characters currently in the window\n    const charSet = new Set();\n    let left = 0;\n    let maxLen = 0;\n\n    for (let right = 0; right < s.length; right++) {\n        const newChar = s[right];\n\n        // If the new character is already in the window, shrink from the left\n        // until we remove the duplicate\n        while (charSet.has(newChar)) {\n            const leftChar = s[left];\n            charSet.delete(leftChar);\n            left = left + 1;\n        }\n\n        // Now the new character is safe to add\n        charSet.add(newChar);\n\n        // Check if this window is the longest seen so far\n        const currentWindowLen = right - left + 1;\n        if (currentWindowLen > maxLen) {\n            maxLen = currentWindowLen;\n        }\n    }\n\n    return maxLen;\n};","sourceHash":"e592ba38bc111f2aae1e81482caddc24901b82392195598b227e4d98d29a26ca","generatorHash":"d120be949580d04de09546df406ed5b5a640d1e6ded6b75fa128e96dd15f723b","fixtureHash":"cb24030eaa88df677b412f1b3eccdcb528b96fa70296557f7927b578b29ba78d","examples":[{"name":"Example","input":["abcabcbb"],"expected":3,"result":3,"steps":[{"site":17,"line":1,"kind":"call","label":"lengthOfLongestSubstring","state":{"s":"abcabcbb"},"input":{"s":"abcabcbb"},"heap":{},"value":{"$scalar":"undefined"},"stack":["lengthOfLongestSubstring"]},{"site":0,"line":3,"kind":"statement","label":"const charSet = new Set();","state":{"s":"abcabcbb","charSet":{"$ref":"o1"}},"input":{"s":"abcabcbb"},"heap":{"o1":{"kind":"set","items":[]}},"value":{"$scalar":"undefined"},"stack":["lengthOfLongestSubstring"]},{"site":1,"line":4,"kind":"statement","label":"let left = 0;","state":{"s":"abcabcbb","charSet":{"$ref":"o1"},"left":0},"input":{"s":"abcabcbb"},"heap":{},"value":{"$scalar":"undefined"},"stack":["lengthOfLongestSubstring"]},{"site":2,"line":5,"