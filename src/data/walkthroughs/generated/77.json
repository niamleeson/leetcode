{"id":77,"title":"Combinations","topic":"Backtracking","code":"var combine = function(n, k) {\n    const result = [];\n\n    const backtrack = (start, current) => {\n        // Base case: picked exactly k numbers — record this combination\n        if (current.length === k) {\n            result.push([...current]);\n            return;\n        }\n\n        // Pruning: we need (k - current.length) more numbers.\n        // The largest valid starting point is n - (k - current.length) + 1,\n        // because we need enough numbers remaining to fill the combination.\n        const numbersNeeded = k - current.length;\n        const upperBound = n - numbersNeeded + 1;\n\n        for (let i = start; i <= upperBound; i++) {\n            // Choose number i\n            current.push(i);\n\n            // Recurse: next number must be greater than i\n            backtrack(i + 1, current);\n\n            // Undo the choice (backtrack)\n            current.pop();\n        }\n    };\n\n    backtrack(1, []);\n    return result;\n};","sourceHash":"dd2a1bcd274dc994f8b7a69b95571fe762b1bbde5cf995780abb1da9f0d877c9","generatorHash":"346a6be1776236e10a13a085800eed1d82b9ee73c013d4ee06a9045e463e80ed","fixtureHash":"352645a4cda242f6cf23560e862c14e0ab6a651b2cc587e4bd527d3e0cf725ed","indexing":{},"examples":[{"name":"Example","input":[4,2],"expected":[[1,2],[1,3],[1,4],[2,3],[2,4],[3,4]],"result":[[1,2],[1,3],[1,4],[2,3],[2,4],[3,4]],"steps":[{"site":14,"line":1,"lines":[1],"start":14,"end":938,"kind":"call","label":"combine","state":{"n":4,"k":2},"input":{"n":4,"k":2},"heap":{},"value":{"$scalar":"undefined"},"stack":["combine"]},{"site":0,"line":2,"lines":[2],"start":35,"end":53,"kind":"statement","label":"const result = [];","state":{"n":4,"k":2,"result":{"$ref":"o1"}},"input":{"n":4,"k":2},"heap":{"o1":{"kind":"array","items":[]}},"value":{"$scalar":"undefined"},"stack":["combine"]},{"site":11,"line":4,"lines":[4],"start":77,"end":893,"kind":"call","label":"backtrack","state":{"start":1,