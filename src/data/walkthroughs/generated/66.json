{"id":66,"title":"Plus One","topic":"Math & Geometry","code":"var plusOne = function(digits) {\n    // Start from the least significant digit (rightmost)\n    for (let i = digits.length - 1; i >= 0; i--) {\n        if (digits[i] < 9) {\n            // No carry needed: just increment and return\n            digits[i] = digits[i] + 1;\n            return digits;\n        }\n        // This digit was 9: it becomes 0 and carry propagates left\n        digits[i] = 0;\n    }\n\n    // All digits were 9 (e.g., 999 -> 1000): prepend a 1\n    return [1, ...digits];\n};","sourceHash":"cc6b41964edc3004155ab820e05e0ecfff439b1d2fa6b27abed4d6e0e3a9471a","generatorHash":"b66120ae1d9d0cfc0bba45cf6f5673ac49a7d0cba8100ee7e720869b46fddc24","fixtureHash":"ae0aa641469102732496420f1776fbe7e52a92e901a1dcf9d1aa1726425d8307","indexing":{"digits":{"indices":["i"],"cells":[]}},"examples":[{"name":"Example","input":[[1,2,3]],"expected":[1,2,4],"result":[1,2,4],"steps":[{"site":7,"line":1,"lines":[1],"start":14,"end":489,"kind":"call","label":"plusOne","state":{"digits":{"$ref":"o1"}},"input":{"digits":{"$ref":"o1"}},"heap":{"o1":{"kind":"array","items":[1,2,3]}},"value":{"$scalar":"undefined"},"stack":["plusOne"]},{"site":4,"line":3,"lines":[3],"start":127,"end":133,"kind":"check","label":"i >= 0","state":{"i":2,"digits":{"$ref":"o1"}},"input":{"digits":{"$ref":"o1"}},"heap":{},"value":true,"stack":["plusOne"]},{"site":2,"line":4,"lines":[4],"start":154,"end":167,"kind":"check","label":"digits[i] < 9","state":{"i":2,"digits":{"$ref":"o1"}},"input":{"digits":{"$ref":"o1"}},"heap":{},"value":true,"stack":["plusOne"]},{"site":0,"line":6,"lines":[6],"start":241,"end":267,"kind":"statement","label":"digits[i] = digits[i] + 1;","state":{"i":2,"digits":{"$ref":"o1"}},"input":{"digits":{"$ref":"o1"}},"heap":{"o1":{"kind":"array","items":[1,2,4]}},"value":{"$scalar":"undefined"},"stack":["plusOne"]},{"site":1,"line":7,"lines":[7],"start":280,"end":294,"kind":"return","label":"return digits;","state":{"