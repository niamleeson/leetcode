{"id":128,"title":"Longest Consecutive Sequence","topic":"Arrays & Hashing","code":"var longestConsecutive = function(nums) {\n    const numSet = new Set(nums);\n    let longest = 0;\n\n    for (const num of numSet) {\n        // Only start counting if this is the beginning of a sequence\n        const hasPrevious = numSet.has(num - 1);\n        if (hasPrevious) continue;\n\n        // Count how long this sequence goes\n        let length = 1;\n        let next = num + 1;\n        while (numSet.has(next)) {\n            length++;\n            next++;\n        }\n\n        // Update the longest sequence found\n        if (length > longest) {\n            longest = length;\n        }\n    }\n\n    return longest;\n};","sourceHash":"86f0d87d1576be27f39f45740b9c52215e8f726f40580dfe50749ebb962fabeb","generatorHash":"b66120ae1d9d0cfc0bba45cf6f5673ac49a7d0cba8100ee7e720869b46fddc24","fixtureHash":"3632a0e4781b5c76481262b5ce39b587d6f81902535be98c1c9d7ca3ecd48136","indexing":{},"examples":[{"name":"Example","input":[[100,4,200,1,3,2]],"expected":4,"result":4,"steps":[{"site":15,"line":1,"lines":[1],"start":25,"end":615,"kind":"call","label":"longestConsecutive","state":{"nums":{"$ref":"o1"}},"input":{"nums":{"$ref":"o1"}},"heap":{"o1":{"kind":"array","items":[100,4,200,1,3,2]}},"value":{"$scalar":"undefined"},"stack":["longestConsecutive"]},{"site":0,"line":2,"lines":[2],"start":46,"end":75,"kind":"statement","label":"const numSet = new Set(nums);","state":{"nums":{"$ref":"o1"},"numSet":{"$ref":"o2"}},"input":{"nums":{"$ref":"o1"}},"heap":{"o2":{"kind":"set","items":[100,4,200,1,3,2]}},"value":{"$scalar":"undefined"},"stack":["longestConsecutive"]},{"site":1,"line":3,"lines":[3],"start":80,"end":96,"kind":"statement","label":"let longest = 0;","state":{"nums":{"$ref":"o1"},"numSet":{"$ref":"o2"},"longest":0},"input":{"nums":{"$ref":"o1"}},"heap":{},"value":{"$scalar":"undefined"},"stack":["longestConsecutive"]},{"site":12,"line":5,"lines":[5],"start":102,"end":592,"kind":"it