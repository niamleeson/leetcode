{"id":15,"title":"3Sum","topic":"Two Pointers","code":"var threeSum = function(nums) {\n    // Sort so duplicates are adjacent and two-pointer works correctly\n    nums.sort((a, b) => a - b);\n    const result = [];\n\n    for (let i = 0; i < nums.length - 2; i++) {\n        const fixedNum = nums[i];\n\n        // Skip duplicate values for the fixed number\n        if (i > 0 && fixedNum === nums[i - 1]) {\n            continue;\n        }\n\n        let left = i + 1;\n        let right = nums.length - 1;\n\n        while (left < right) {\n            const total = fixedNum + nums[left] + nums[right];\n\n            if (total < 0) {\n                // Sum too small, move left pointer right to increase it\n                left = left + 1;\n            } else if (total > 0) {\n                // Sum too large, move right pointer left to decrease it\n                right = right - 1;\n            } else {\n                // Found a valid triplet\n                result.push([fixedNum, nums[left], nums[right]]);\n\n                // Skip duplicates for the left pointer\n                while (left < right && nums[left] === nums[left + 1]) {\n                    left = left + 1;\n                }\n\n                // Skip duplicates for the right pointer\n                while (left < right && nums[right] === nums[right - 1]) {\n                    right = right - 1;\n                }\n\n                left = left + 1;\n                right = right - 1;\n            }\n        }\n    }\n\n    return result;\n};","sourceHash":"8889f556767020a8b22cc4908b84d7d537aa9b617ba3ff509c273ffb481a3574","generatorHash":"346a6be1776236e10a13a085800eed1d82b9ee73c013d4ee06a9045e463e80ed","fixtureHash":"ca971736cb70d41b868df8de8fd6a933f4053a3b1b51f1df7e220d2be107fa55","indexing":{"nums":{"indices":["i","left","right"],"cells":[]}},"examples":[{"name":"Example","input":[[-1,0,1,2,-1,-4]],"expected":[[-1,-1,2],[-1,0,1]],"result":[[-1,-1,2],[-1,0,1]],"steps":[{"site":23,"line":1,"li