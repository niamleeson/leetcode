{"id":746,"title":"Min Cost Climbing Stairs","topic":"1-D Dynamic Programming","code":"var minCostClimbingStairs = function(cost) {\n    // Work backwards, starting from the third-to-last step.\n    // The last two steps don't need updating because they lead directly\n    // to the top with no additional choices.\n    for (let i = cost.length - 3; i >= 0; i--) {\n        // From step i, we can jump 1 step (to i+1) or 2 steps (to i+2).\n        // Add the cheaper of those two future costs to cost[i] in place.\n        const jumpOne  = cost[i + 1];\n        const jumpTwo  = cost[i + 2];\n        cost[i] += Math.min(jumpOne, jumpTwo);\n    }\n\n    // We can start at either step 0 or step 1 — take the cheaper option\n    return Math.min(cost[0], cost[1]);\n};","sourceHash":"9bce6f187386f970d1a6c7529a31603ce446bcc5515603b2125f13e9bf3f90b9","generatorHash":"b66120ae1d9d0cfc0bba45cf6f5673ac49a7d0cba8100ee7e720869b46fddc24","fixtureHash":"1e3af131d235144bad89cf2d2ce7fc74d2ae62008d1d6d07eef175787d2f9b1b","indexing":{"cost":{"indices":["i"],"cells":[]}},"examples":[{"name":"Example","input":[[10,15,20]],"expected":15,"result":15,"steps":[{"site":6,"line":1,"lines":[1],"start":28,"end":664,"kind":"call","label":"minCostClimbingStairs","state":{"cost":{"$ref":"o1"}},"input":{"cost":{"$ref":"o1"}},"heap":{"o1":{"kind":"array","items":[10,15,20]}},"value":{"$scalar":"undefined"},"stack":["minCostClimbingStairs"]},{"site":3,"line":5,"lines":[5],"start":259,"end":265,"kind":"check","label":"i >= 0","state":{"i":0,"cost":{"$ref":"o1"}},"input":{"cost":{"$ref":"o1"}},"heap":{},"value":true,"stack":["minCostClimbingStairs"]},{"site":0,"line":8,"lines":[8],"start":429,"end":458,"kind":"statement","label":"const jumpOne = cost[i + 1];","state":{"jumpOne":15,"i":0,"cost":{"$ref":"o1"}},"input":{"cost":{"$ref":"o1"}},"heap":{},"value":{"$scalar":"undefined"},"stack":["minCostClimbingStairs"]},{"site":1,"line":9,"lines":[9],"start":467,"end":496,"kind":"statement","label":"const jumpTwo =