{"id":268,"title":"Missing Number","topic":"Bit Manipulation","code":"var missingNumber = function(nums) {\n    // Start with n (the largest expected index, not present in nums as an index)\n    // We will XOR in every index 0..n-1 and every value in nums\n    // Each number that appears in both sets cancels out; only the missing one remains\n    let result = nums.length;\n\n    for (let i = 0; i < nums.length; i++) {\n        // XOR the current index (part of the full range 0..n)\n        result = result ^ i;\n\n        // XOR the current value (the numbers actually present)\n        result = result ^ nums[i];\n    }\n\n    // All present numbers cancelled; only the missing number remains\n    return result;\n};","sourceHash":"d291ec795e29605753a3742899b83237f464764fee5877968734f213f2548850","generatorHash":"b66120ae1d9d0cfc0bba45cf6f5673ac49a7d0cba8100ee7e720869b46fddc24","fixtureHash":"5d1f5ad4d2ee98ceb0990eb91d18351eba6e7c36439ac69c28d6d7cb733e418c","indexing":{"nums":{"indices":["i"],"cells":[]}},"examples":[{"name":"Example","input":[[3,0,1]],"expected":2,"result":2,"steps":[{"site":6,"line":1,"lines":[1],"start":20,"end":635,"kind":"call","label":"missingNumber","state":{"nums":{"$ref":"o1"}},"input":{"nums":{"$ref":"o1"}},"heap":{"o1":{"kind":"array","items":[3,0,1]}},"value":{"$scalar":"undefined"},"stack":["missingNumber"]},{"site":0,"line":5,"lines":[5],"start":275,"end":300,"kind":"statement","label":"let result = nums.length;","state":{"nums":{"$ref":"o1"},"result":3},"input":{"nums":{"$ref":"o1"}},"heap":{},"value":{"$scalar":"undefined"},"stack":["missingNumber"]},{"site":3,"line":7,"lines":[7],"start":322,"end":337,"kind":"check","label":"i < nums.length","state":{"i":0,"nums":{"$ref":"o1"},"result":3},"input":{"nums":{"$ref":"o1"}},"heap":{},"value":true,"stack":["missingNumber"]},{"site":1,"line":9,"lines":[9],"start":417,"end":437,"kind":"statement","label":"result = result ^ i;","state":{"i":0,"nums":{"$ref":"o1"},"result":3},"input":{"nums":{"$r