{"id":1871,"title":"Jump Game VII","topic":"Greedy","code":"var canReach = function(s, minJump, maxJump) {\n    const n = s.length;\n\n    // Quick exit: if the last character is '1', we can never land there\n    if (s[n - 1] === '1') {\n        return false;\n    }\n\n    // reachable[i] is true if we can reach index i\n    const reachable = new Array(n).fill(false);\n    reachable[0] = true;  // always start at index 0\n\n    // count = number of reachable positions in the sliding window [i-maxJump, i-minJump]\n    let count = 0;\n\n    for (let i = 1; i < n; i++) {\n        // When i-minJump enters the window (from the right side), add it\n        if (i >= minJump) {\n            count += reachable[i - minJump] ? 1 : 0;\n        }\n\n        // When i-maxJump-1 leaves the window (from the left side), subtract it\n        if (i > maxJump) {\n            count -= reachable[i - maxJump - 1] ? 1 : 0;\n        }\n\n        // Position i is reachable if at least one position in the window is reachable\n        // AND the current cell is '0' (we can land here)\n        reachable[i] = count > 0 && s[i] === '0';\n    }\n\n    return reachable[n - 1];\n};","sourceHash":"43625f2b52b07f82f7841a986f082f0c1a61f613cc2300d0d207831758b645ad","generatorHash":"d120be949580d04de09546df406ed5b5a640d1e6ded6b75fa128e96dd15f723b","fixtureHash":"9ec976582a2b2d83bd5fbd0f45c6f3df0f74bd894c7e116fe3662abc3a68b713","examples":[{"name":"Example","input":["011010",2,3],"expected":true,"result":true,"steps":[{"site":18,"line":1,"kind":"call","label":"canReach","state":{"s":"011010","minJump":2,"maxJump":3},"input":{"s":"011010","minJump":2,"maxJump":3},"heap":{},"value":{"$scalar":"undefined"},"stack":["canReach"]},{"site":0,"line":2,"kind":"statement","label":"const n = s.length;","state":{"s":"011010","minJump":2,"maxJump":3,"n":6},"input":{"s":"011010","minJump":2,"maxJump":3},"heap":{},"value":{"$scalar":"undefined"},"stack":["canReach"]},{"site":2,"line":5,"kind":"check","label":"s[n - 1] =