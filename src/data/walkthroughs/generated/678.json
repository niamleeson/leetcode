{"id":678,"title":"Valid Parenthesis String","topic":"Greedy","code":"var checkValidString = function(s) {\n    // minOpen = minimum possible number of unmatched open parens\n    //   (treat '*' as ')' or empty string — pessimistic for opens)\n    // maxOpen = maximum possible number of unmatched open parens\n    //   (treat '*' as '(' — optimistic for opens)\n    let minOpen = 0;\n    let maxOpen = 0;\n\n    for (const c of s) {\n        if (c === '(') {\n            // Both min and max increase — definite open paren\n            minOpen++;\n            maxOpen++;\n        } else if (c === ')') {\n            // Both min and max decrease — definite close paren\n            minOpen--;\n            maxOpen--;\n        } else {\n            // '*' can be '(' (max increases), ')' (min decreases), or '' (neither)\n            minOpen--;  // most pessimistic: treat as ')'\n            maxOpen++;  // most optimistic: treat as '('\n        }\n\n        // If even in the best case we have too many closes, it is impossible\n        if (maxOpen < 0) {\n            return false;\n        }\n\n        // minOpen cannot be negative — we can always choose '*' as '' to prevent it\n        if (minOpen < 0) {\n            minOpen = 0;\n        }\n    }\n\n    // Valid if it is possible for all opens to be matched (min can reach 0)\n    return minOpen === 0;\n};","sourceHash":"5cdc30b9cf62284efd4e26adf060ef78fa8396893f1bbb02b56fecde721b640b","generatorHash":"d120be949580d04de09546df406ed5b5a640d1e6ded6b75fa128e96dd15f723b","fixtureHash":"1838da5eb725071412fbcb786b7f513366f41667a59a1ddbc83c982f113c3c77","examples":[{"name":"Example","input":["()"],"expected":true,"result":true,"steps":[{"site":17,"line":1,"kind":"call","label":"checkValidString","state":{"s":"()"},"input":{"s":"()"},"heap":{},"value":{"$scalar":"undefined"},"stack":["checkValidString"]},{"site":0,"line":6,"kind":"statement","label":"let minOpen = 0;","state":{"s":"()","minOpen":0},"input":{"s":"()"},"heap":{},"value":