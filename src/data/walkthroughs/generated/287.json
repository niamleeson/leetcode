{"id":287,"title":"Find The Duplicate Number","topic":"Linked List","code":"var findDuplicate = function(nums) {\n    // Treat the array as a linked list: index i points to nums[i]\n    // A duplicate value means two indices point to the same index -> cycle\n\n    // Phase 1: Find the meeting point inside the cycle\n    let slow = nums[0];\n    let fast = nums[0];\n    do {\n        slow = nums[slow];           // move 1 step\n        fast = nums[nums[fast]];     // move 2 steps\n    } while (slow !== fast);\n\n    // Phase 2: Find the cycle entrance (= the duplicate number)\n    // Reset slow to the start; advance both one step at a time\n    slow = nums[0];\n    while (slow !== fast) {\n        slow = nums[slow];\n        fast = nums[fast];\n    }\n\n    // They meet at the cycle entrance, which is the duplicate value\n    return slow;\n};","sourceHash":"defd21266adeae9c41537875b83b6672d86282377888fe83e99f6e3dcd7d0dfb","generatorHash":"d120be949580d04de09546df406ed5b5a640d1e6ded6b75fa128e96dd15f723b","fixtureHash":"bf8ab978da8d4b660b7e601c2f68665907c6c75d73bd9b62bceb7e884606c102","examples":[{"name":"Example","input":[[1,3,4,2,2]],"expected":2,"result":2,"steps":[{"site":10,"line":1,"kind":"call","label":"findDuplicate","state":{"nums":{"$ref":"o1"}},"input":{"nums":{"$ref":"o1"}},"heap":{"o1":{"kind":"array","items":[1,3,4,2,2]}},"value":{"$scalar":"undefined"},"stack":["findDuplicate"]},{"site":0,"line":6,"kind":"statement","label":"let slow = nums[0];","state":{"nums":{"$ref":"o1"},"slow":1},"input":{"nums":{"$ref":"o1"}},"heap":{},"value":{"$scalar":"undefined"},"stack":["findDuplicate"]},{"site":1,"line":7,"kind":"statement","label":"let fast = nums[0];","state":{"nums":{"$ref":"o1"},"slow":1,"fast":1},"input":{"nums":{"$ref":"o1"}},"heap":{},"value":{"$scalar":"undefined"},"stack":["findDuplicate"]},{"site":2,"line":9,"kind":"statement","label":"slow = nums[slow];","state":{"nums":{"$ref":"o1"},"slow":3,"fast":1},"input":{"nums":{"$ref":"o1"}},"heap":{},"val