{"id":343,"title":"Integer Break","topic":"1-D Dynamic Programming","code":"var integerBreak = function(n) {\n    // Special cases: 2 and 3 must be split but the pieces are smaller than the whole\n    if (n === 2) return 1; // 1 + 1 = 2, product = 1\n    if (n === 3) return 2; // 1 + 2 = 3, product = 2 (best: don't split the 2)\n\n    // For n >= 4, greedily break off 3s\n    // Stop at n <= 4 because:\n    //   - n=4: 2*2=4, best to keep as-is (not break into 3+1=3)\n    //   - n=3: already handled as remainder\n    let product = 1;\n    while (n > 4) {\n        product *= 3;\n        n -= 3;\n    }\n\n    // Multiply by remaining n (could be 2, 3, or 4 — all optimal as-is)\n    return product * n;\n};","sourceHash":"b617be3811bc5a3d3d2323a49078956a039d73d50da9484d405a9361831778d4","generatorHash":"346a6be1776236e10a13a085800eed1d82b9ee73c013d4ee06a9045e463e80ed","fixtureHash":"7f4c33a75fc6b0a87d0327107794faffa6423356ac276dcdf279095f9158999a","indexing":{},"examples":[{"name":"Example","input":[10],"expected":36,"result":36,"steps":[{"site":9,"line":1,"lines":[1],"start":19,"end":618,"kind":"call","label":"integerBreak","state":{"n":10},"input":{"n":10},"heap":{},"value":{"$scalar":"undefined"},"stack":["integerBreak"]},{"site":1,"line":3,"lines":[3],"start":127,"end":134,"kind":"check","label":"n === 2","state":{"n":10},"input":{"n":10},"heap":{},"value":false,"stack":["integerBreak"]},{"site":3,"line":4,"lines":[4],"start":180,"end":187,"kind":"check","label":"n === 3","state":{"n":10},"input":{"n":10},"heap":{},"value":false,"stack":["integerBreak"]},{"site":4,"line":10,"lines":[10],"start":438,"end":454,"kind":"statement","label":"let product = 1;","state":{"n":10,"product":1},"input":{"n":10},"heap":{},"value":{"$scalar":"undefined"},"stack":["integerBreak"]},{"site":7,"line":11,"lines":[11],"start":466,"end":471,"kind":"check","label":"n > 4","state":{"n":10,"product":1},"input":{"n":10},"heap":{},"value":true,"stack":["integerBreak"]},{"site":5,"line":12,"li