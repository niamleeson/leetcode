{"id":92,"title":"Reverse Linked List II","topic":"Linked List","code":"var reverseBetween = function(head, left, right) {\n    // Dummy node handles the edge case where left = 1 (head gets reversed)\n    const dummy = new ListNode(0, head);\n    let prev = dummy;\n\n    // Advance prev to the node just before position 'left'\n    for (let i = 0; i < left - 1; i++) {\n        prev = prev.next;\n    }\n\n    // curr starts at position 'left'\n    let curr = prev.next;\n\n    // Reverse (right - left) times by moving the next node to the front\n    for (let i = 0; i < right - left; i++) {\n        const nextNode = curr.next;\n\n        // Remove nextNode from its position and insert it right after prev\n        curr.next = nextNode.next;\n        nextNode.next = prev.next;\n        prev.next = nextNode;\n    }\n\n    return dummy.next;\n};","sourceHash":"f712b9ad09b2702d77ed474d724754d55a50fc334726be1ea0450ad8f4aa3759","generatorHash":"346a6be1776236e10a13a085800eed1d82b9ee73c013d4ee06a9045e463e80ed","fixtureHash":"11075ca9bdd81a08071aa0f02b4307d1993a0547fa4c31c44b37699d26d53db9","indexing":{},"examples":[{"name":"Example","input":[{"$list":[1,2,3,4,5]},2,4],"expected":[1,4,3,2,5],"result":[1,4,3,2,5],"steps":[{"site":13,"line":1,"lines":[1],"start":21,"end":752,"kind":"call","label":"reverseBetween","state":{"head":{"$ref":"o1"},"left":2,"right":4},"input":{"head":{"$ref":"o1"},"left":2,"right":4},"heap":{"o1":{"kind":"list","fields":{"val":1,"next":{"$ref":"o2"}}},"o2":{"kind":"list","fields":{"val":2,"next":{"$ref":"o3"}}},"o3":{"kind":"list","fields":{"val":3,"next":{"$ref":"o4"}}},"o4":{"kind":"list","fields":{"val":4,"next":{"$ref":"o5"}}},"o5":{"kind":"list","fields":{"val":5,"next":null}}},"value":{"$scalar":"undefined"},"stack":["reverseBetween"]},{"site":0,"line":3,"lines":[3],"start":131,"end":167,"kind":"statement","label":"const dummy = new ListNode(0, head);","state":{"head":{"$ref":"o1"},"left":2,"right":4,"dummy":{"$ref":"o6"}},"input":{"head":{"$ref":