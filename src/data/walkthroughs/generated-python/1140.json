{"id":1140,"language":"python","title":"Stone Game II","topic":"2-D Dynamic Programming","code":"class Solution:\n    def stoneGameII(self, piles: list[int]) -> int:\n        from functools import lru_cache\n        n = len(piles)\n        suffix = [0] * (n + 1)\n        for i in range(n - 1, -1, -1):\n            suffix[i] = suffix[i + 1] + piles[i]\n\n        @lru_cache(maxsize=None)\n        def dp(i, m):\n            if i >= n:\n                return 0\n            if i + 2 * m >= n:\n                return suffix[i]\n            best = 0\n            for x in range(1, 2 * m + 1):\n                best = max(best, suffix[i] - dp(i + x, max(m, x)))\n            return best\n\n        return dp(0, 1)","sourceHash":"5c0c70d3c3bc0797794afd2b350028302476764d05bc45063c4fead8b82995b4","generatorHash":"fb11d879369abb4c5c6a89d97c8173cdf4d1aca2fde0aff2e3432df8f89f84da","fixtureHash":"52721541da21c89835bdda2031043ccee200996a206e6b985c70d31b522eb5dd","indexing":{"list":{"indices":["int"],"cells":[]},"suffix":{"indices":["i"],"cells":[]},"piles":{"indices":["i"],"cells":[]}},"examples":[{"name":"Example","input":[[2,7,9,4,4]],"expected":10,"result":10,"steps":[{"site":0,"line":2,"lines":[2],"kind":"call","label":"stoneGameII(self, piles)","state":{"self":{"$ref":"o2"},"piles":{"$ref":"o1"}},"input":{"piles":{"$ref":"o1"}},"heap":{"o1":{"kind":"array","typeName":"list","items":[2,7,9,4,4]},"o2":{"kind":"object","typeName":"Solution","fields":{}}},"value":null,"stack":["stoneGameII(self, piles)"]},{"site":1,"line":3,"lines":[3],"kind":"statement","label":"from functools import lru_cache","state":{"self":{"$ref":"o2"},"piles":{"$ref":"o1"}},"input":{"piles":{"$ref":"o1"}},"heap":{},"value":null,"stack":["stoneGameII(self, piles)"]},{"site":2,"line":4,"lines":[4],"kind":"statement","label":"n = len(piles)","state":{"self":{"$ref":"o2"},"piles":{"$ref":"o1"},"n":5},"input":{"piles":{"$ref":"o1"}},"heap":{},"value":null,"stack":["stoneGameII(self, piles)"]},{"site":3,"line":5,"li