{"id":778,"language":"python","title":"Swim In Rising Water","topic":"Advanced Graphs","code":"import heapq\n\nclass Solution:\n    def swimInWater(self, grid: list[list[int]]) -> int:\n        n = len(grid)\n        visited = [[False] * n for _ in range(n)]\n        heap = [(grid[0][0], 0, 0)]\n        visited[0][0] = True\n        while heap:\n            t, r, c = heapq.heappop(heap)\n            if r == n - 1 and c == n - 1:\n                return t\n            for dr, dc in [(0,1),(0,-1),(1,0),(-1,0)]:\n                nr, nc = r + dr, c + dc\n                if 0 <= nr < n and 0 <= nc < n and not visited[nr][nc]:\n                    visited[nr][nc] = True\n                    heapq.heappush(heap, (max(t, grid[nr][nc]), nr, nc))\n        return -1","sourceHash":"14ec1574614116125decae95e90b0f0a7f0f0079148816d11569ba89a53c420c","generatorHash":"fb11d879369abb4c5c6a89d97c8173cdf4d1aca2fde0aff2e3432df8f89f84da","fixtureHash":"648978db39c9ef2c4f6dc1faca6cfdd9d2c9ab19f285bdcf514aa8331002fec0","indexing":{"list":{"indices":["int"],"cells":[]},"visited":{"indices":["nr"],"cells":[["nr","nc"]]},"grid":{"indices":["nr"],"cells":[["nr","nc"]]}},"examples":[{"name":"Example","input":[[[0,2],[1,3]]],"expected":3,"result":3,"steps":[{"site":0,"line":4,"lines":[4],"kind":"call","label":"swimInWater(self, grid)","state":{"self":{"$ref":"o4"},"grid":{"$ref":"o1"}},"input":{"grid":{"$ref":"o1"}},"heap":{"o1":{"kind":"array","typeName":"list","items":[{"$ref":"o2"},{"$ref":"o3"}]},"o2":{"kind":"array","typeName":"list","items":[0,2]},"o3":{"kind":"array","typeName":"list","items":[1,3]},"o4":{"kind":"object","typeName":"Solution","fields":{}}},"value":null,"stack":["swimInWater(self, grid)"]},{"site":1,"line":5,"lines":[5],"kind":"statement","label":"n = len(grid)","state":{"self":{"$ref":"o4"},"grid":{"$ref":"o1"},"n":2},"input":{"grid":{"$ref":"o1"}},"heap":{},"value":null,"stack":["swimInWater(self, grid)"]},{"site":2,"line":6,"lines":[6],"kind":"statement","label":"visite