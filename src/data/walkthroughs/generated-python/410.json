{"id":410,"language":"python","title":"Split Array Largest Sum","topic":"Binary Search","code":"class Solution:\n    def splitArray(self, nums: list[int], k: int) -> int:\n        def can_split(max_sum: int) -> bool:\n            subarrays = 1\n            current_sum = 0\n            for num in nums:\n                if current_sum + num > max_sum:\n                    subarrays += 1\n                    current_sum = num\n                    if subarrays > k:\n                        return False\n                else:\n                    current_sum += num\n            return True\n\n        lo, hi = max(nums), sum(nums)\n\n        while lo < hi:\n            mid = (lo + hi) // 2\n            if can_split(mid):\n                hi = mid\n            else:\n                lo = mid + 1\n\n        return lo","sourceHash":"0fda18eb0368013c0f3222944bb4a6c3e3c30c5683e09c620f6649e29ab60944","generatorHash":"fb11d879369abb4c5c6a89d97c8173cdf4d1aca2fde0aff2e3432df8f89f84da","fixtureHash":"a60b15be95c00233e6203aa7bb9288516fd1a0a58b007419cf46e048f32db02e","indexing":{"list":{"indices":["int"],"cells":[]}},"examples":[{"name":"Example","input":[[7,2,5,10,8],2],"expected":18,"result":18,"steps":[{"site":0,"line":2,"lines":[2],"kind":"call","label":"splitArray(self, nums, k)","state":{"self":{"$ref":"o2"},"nums":{"$ref":"o1"},"k":2},"input":{"nums":{"$ref":"o1"},"k":2},"heap":{"o1":{"kind":"array","typeName":"list","items":[7,2,5,10,8]},"o2":{"kind":"object","typeName":"Solution","fields":{}}},"value":null,"stack":["splitArray(self, nums, k)"]},{"site":1,"line":3,"lines":[3],"kind":"statement","label":"def can_split(max_sum: int) -> bool:","state":{"self":{"$ref":"o2"},"nums":{"$ref":"o1"},"k":2},"input":{"nums":{"$ref":"o1"},"k":2},"heap":{},"value":null,"stack":["splitArray(self, nums, k)"]},{"site":2,"line":16,"lines":[16],"kind":"statement","label":"lo, hi = max(nums), sum(nums)","state":{"self":{"$ref":"o2"},"nums":{"$ref":"o1"},"k":2,"lo":10,"hi":32},"input":{"nums":{"