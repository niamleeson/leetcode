{"id":435,"language":"python","title":"Non Overlapping Intervals","topic":"Intervals","code":"class Solution:\n    def eraseOverlapIntervals(self, intervals: List[List[int]]) -> int:\n        intervals.sort(key=lambda interval: interval[0])\n        removed = 0\n        previous_end = intervals[0][1]\n\n        for i in range(1, len(intervals)):\n            start, end = intervals[i]\n            if start < previous_end:\n                # They overlap: remove the interval that ends later.\n                removed += 1\n                previous_end = min(previous_end, end)\n            else:\n                # No overlap: keep this interval.\n                previous_end = end\n\n        return removed","sourceHash":"e40946f9817869db6c32b83e0bde16b1664be07b2aaa52cc11d51dc1b6664539","generatorHash":"fb11d879369abb4c5c6a89d97c8173cdf4d1aca2fde0aff2e3432df8f89f84da","fixtureHash":"65e3e2fc99df26a9d43cd9ada8f6d6603d9ec778b4266c2de4c7968583c528e6","indexing":{"intervals":{"indices":["i"],"cells":[]},"List":{"indices":["int"],"cells":[]}},"examples":[{"name":"Example","input":[[[1,2],[2,3],[3,4],[1,3]]],"expected":1,"result":1,"steps":[{"site":0,"line":2,"lines":[2],"kind":"call","label":"eraseOverlapIntervals(self, intervals)","state":{"self":{"$ref":"o6"},"intervals":{"$ref":"o1"}},"input":{"intervals":{"$ref":"o1"}},"heap":{"o1":{"kind":"array","typeName":"list","items":[{"$ref":"o2"},{"$ref":"o3"},{"$ref":"o4"},{"$ref":"o5"}]},"o2":{"kind":"array","typeName":"list","items":[1,2]},"o3":{"kind":"array","typeName":"list","items":[2,3]},"o4":{"kind":"array","typeName":"list","items":[3,4]},"o5":{"kind":"array","typeName":"list","items":[1,3]},"o6":{"kind":"object","typeName":"Solution","fields":{}}},"value":null,"stack":["eraseOverlapIntervals(self, intervals)"]},{"site":1,"line":3,"lines":[3],"kind":"statement","label":"intervals.sort(key=lambda interval: interval[0])","state":{"self":{"$ref":"o6"},"intervals":{"$ref":"o1"}},"input":{"intervals":{"$ref":"o1"}},"heap":{"o