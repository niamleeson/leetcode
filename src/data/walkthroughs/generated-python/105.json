{"id":105,"language":"python","title":"Construct Binary Tree From Preorder And Inorder Traversal","topic":"Trees","code":"class Solution:\n    def buildTree(self, preorder: List[int], inorder: List[int]) -> Optional[TreeNode]:\n        inorder_map = {val: idx for idx, val in enumerate(inorder)}\n        self.pre_idx = 0\n\n        def build(left, right):\n            if left > right:\n                return None\n            root_val = preorder[self.pre_idx]\n            self.pre_idx += 1\n            root = TreeNode(root_val)\n            mid = inorder_map[root_val]\n            root.left = build(left, mid - 1)\n            root.right = build(mid + 1, right)\n            return root\n\n        return build(0, len(inorder) - 1)","sourceHash":"e1a3ff07b7757659d740c0c978f89a20785a137ce133d0a88664bcc92fb8c26f","generatorHash":"fb11d879369abb4c5c6a89d97c8173cdf4d1aca2fde0aff2e3432df8f89f84da","fixtureHash":"3d76bf50ab34e900b346fc472aee5fbf4e1fefc2529f69a468a98b54e631e836","indexing":{"Optional":{"indices":["TreeNode"],"cells":[]},"List":{"indices":["int"],"cells":[]},"inorder_map":{"indices":["root_val"],"cells":[]}},"examples":[{"name":"Example","input":[[3,9,20,15,7],[9,3,15,20,7]],"expected":[3,9,20,null,null,15,7],"result":[3,9,20,null,null,15,7],"steps":[{"site":0,"line":2,"lines":[2],"kind":"call","label":"buildTree(self, preorder, inorder)","state":{"self":{"$ref":"o3"},"preorder":{"$ref":"o1"},"inorder":{"$ref":"o2"}},"input":{"preorder":{"$ref":"o1"},"inorder":{"$ref":"o2"}},"heap":{"o1":{"kind":"array","typeName":"list","items":[3,9,20,15,7]},"o2":{"kind":"array","typeName":"list","items":[9,3,15,20,7]},"o3":{"kind":"object","typeName":"Solution","fields":{}}},"value":null,"stack":["buildTree(self, preorder, inorder)"]},{"site":1,"line":3,"lines":[3],"kind":"statement","label":"inorder_map = {val: idx for idx, val in enumerate(inorder)}","state":{"self":{"$ref":"o3"},"preorder":{"$ref":"o1"},"inorder":{"$ref":"o2"},"idx":0,"val":9},"input":{"preorder":{"$ref":