{"id":269,"language":"python","title":"Alien Dictionary","topic":"Advanced Graphs","code":"class Solution:\n    def alienOrder(self, words: list[str]) -> str:\n        from collections import defaultdict, deque\n        adj = defaultdict(set)\n        in_deg = {c: 0 for w in words for c in w}\n        for i in range(len(words) - 1):\n            w1, w2 = words[i], words[i+1]\n            min_len = min(len(w1), len(w2))\n            if len(w1) > len(w2) and w1[:min_len] == w2[:min_len]:\n                return \"\"\n            for j in range(min_len):\n                if w1[j] != w2[j]:\n                    if w2[j] not in adj[w1[j]]:\n                        adj[w1[j]].add(w2[j])\n                        in_deg[w2[j]] += 1\n                    break\n        queue = deque([c for c in in_deg if in_deg[c] == 0])\n        result = []\n        while queue:\n            c = queue.popleft()\n            result.append(c)\n            for nei in adj[c]:\n                in_deg[nei] -= 1\n                if in_deg[nei] == 0:\n                    queue.append(nei)\n        return \"\".join(result) if len(result) == len(in_deg) else \"\"","sourceHash":"031295406e1b4f7612039b20450b002286f2d94d8321bef58a3c320508ecd1f7","generatorHash":"fb11d879369abb4c5c6a89d97c8173cdf4d1aca2fde0aff2e3432df8f89f84da","fixtureHash":"0428af4e9b351c4971d50be2d162ffee49c3ab6ff642222187a9f6e71be7fa2c","indexing":{"list":{"indices":["str"],"cells":[]},"adj":{"indices":["c"],"cells":[]},"words":{"indices":["i"],"cells":[]},"in_deg":{"indices":["nei","c"],"cells":[]},"w1":{"indices":["j"],"cells":[]},"w2":{"indices":["j"],"cells":[]}},"examples":[{"name":"Example","input":[["wrt","wrf","er","ett","rftt"]],"expected":"wertf","result":"wertf","steps":[{"site":0,"line":2,"lines":[2],"kind":"call","label":"alienOrder(self, words)","state":{"self":{"$ref":"o2"},"words":{"$ref":"o1"}},"input":{"words":{"$ref":"o1"}},"heap":{"o1":{"kind":"array","typeName":"list","items":["wrt","wrf","er","ett","rftt"]},"o2":