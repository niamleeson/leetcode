{"id":622,"language":"python","title":"Design Circular Queue","topic":"Linked List","code":"class MyCircularQueue:\n    def __init__(self, k: int):\n        self.queue = [0] * k\n        self.head = 0\n        self.count = 0\n        self.capacity = k\n\n    def enQueue(self, value: int) -> bool:\n        if self.isFull():\n            return False\n        idx = (self.head + self.count) % self.capacity\n        self.queue[idx] = value\n        self.count += 1\n        return True\n\n    def deQueue(self) -> bool:\n        if self.isEmpty():\n            return False\n        self.head = (self.head + 1) % self.capacity\n        self.count -= 1\n        return True\n\n    def Front(self) -> int:\n        return -1 if self.isEmpty() else self.queue[self.head]\n\n    def Rear(self) -> int:\n        return -1 if self.isEmpty() else self.queue[(self.head + self.count - 1) % self.capacity]\n\n    def isEmpty(self) -> bool:\n        return self.count == 0\n\n    def isFull(self) -> bool:\n        return self.count == self.capacity","sourceHash":"3b73d5789b2b54d08f69268f2438ff042ffe09c0ebafc2e928c7875ba926c1fb","generatorHash":"fb11d879369abb4c5c6a89d97c8173cdf4d1aca2fde0aff2e3432df8f89f84da","fixtureHash":"5a550a17dfad7a5f9a5cade115ec0be4bbded01f0e25450a76e3a5d3a69e30e2","indexing":{"self.queue":{"indices":["idx"],"cells":[]}},"examples":[{"name":"Example","input":[3],"expected":[null,true,true,true,true,3,false,2],"result":[null,true,true,true,true,3,false,2],"steps":[{"site":0,"line":2,"lines":[2],"kind":"call","label":"__init__(self, k)","state":{"self":{"$ref":"o1"},"k":3},"input":{"k":3},"heap":{"o1":{"kind":"object","typeName":"MyCircularQueue","fields":{}}},"value":null,"stack":["__init__(self, k)"]},{"site":1,"line":3,"lines":[3],"kind":"statement","label":"self.queue = [0] * k","state":{"self":{"$ref":"o1"},"k":3},"input":{"k":3},"heap":{"o1":{"kind":"object","typeName":"MyCircularQueue","fields":{"queue":{"$ref":"o2"}}},"o2":{"kind":"array","typeName":"list","ite