{"id":767,"language":"python","title":"Reorganize String","topic":"Heap / Priority Queue","code":"import heapq\nfrom collections import Counter\n\nclass Solution:\n    def reorganizeString(self, s: str) -> str:\n        count = Counter(s)\n        max_count = max(count.values())\n        if max_count > (len(s) + 1) // 2:\n            return \"\"\n        heap = [(-cnt, ch) for ch, cnt in count.items()]\n        heapq.heapify(heap)\n        result = []\n        prev_cnt, prev_ch = 0, ''\n        while heap:\n            cnt, ch = heapq.heappop(heap)\n            result.append(ch)\n            if prev_cnt < 0:\n                heapq.heappush(heap, (prev_cnt, prev_ch))\n            prev_cnt, prev_ch = cnt + 1, ch\n        return ''.join(result)","sourceHash":"56063d8d8375a293ba2d18f6a62f7ca2dc40516377d50c439a23b813921cc9e0","generatorHash":"fb11d879369abb4c5c6a89d97c8173cdf4d1aca2fde0aff2e3432df8f89f84da","fixtureHash":"d81e4ec898fb9b6803d39b2520e35d3beea968a439b48f080a4e44de5553e6a4","indexing":{},"examples":[{"name":"Example","input":["aab"],"expected":"aba","result":"aba","steps":[{"site":0,"line":5,"lines":[5],"kind":"call","label":"reorganizeString(self, s)","state":{"self":{"$ref":"o1"},"s":"aab"},"input":{"s":"aab"},"heap":{"o1":{"kind":"object","typeName":"Solution","fields":{}}},"value":null,"stack":["reorganizeString(self, s)"]},{"site":1,"line":6,"lines":[6],"kind":"statement","label":"count = Counter(s)","state":{"self":{"$ref":"o1"},"s":"aab","count":{"$ref":"o2"}},"input":{"s":"aab"},"heap":{"o2":{"kind":"map","typeName":"Counter","entries":[["a",2],["b",1]]}},"value":null,"stack":["reorganizeString(self, s)"]},{"site":2,"line":7,"lines":[7],"kind":"statement","label":"max_count = max(count.values())","state":{"self":{"$ref":"o1"},"s":"aab","count":{"$ref":"o2"},"max_count":2},"input":{"s":"aab"},"heap":{},"value":null,"stack":["reorganizeString(self, s)"]},{"site":3,"line":8,"lines":[8],"kind":"statement","label":"if max_count > (len(s) + 1) // 2:","stat