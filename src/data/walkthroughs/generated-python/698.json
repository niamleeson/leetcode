{"id":698,"language":"python","title":"Partition to K Equal Sum Subsets","topic":"Backtracking","code":"class Solution:\n    def canPartitionKSubsets(self, nums: list[int], k: int) -> bool:\n        total = sum(nums)\n        if total % k != 0:\n            return False\n        target = total // k\n        nums.sort(reverse=True)\n        if nums[0] > target:\n            return False\n        buckets = [0] * k\n        def backtrack(idx):\n            if idx == len(nums):\n                return all(b == target for b in buckets)\n            seen = set()\n            for i in range(k):\n                if buckets[i] + nums[idx] > target:\n                    continue\n                if buckets[i] in seen:\n                    continue\n                seen.add(buckets[i])\n                buckets[i] += nums[idx]\n                if backtrack(idx + 1):\n                    return True\n                buckets[i] -= nums[idx]\n            return False\n        return backtrack(0)","sourceHash":"363e35c4edd7e1e91bad1fde9cbcbb14d44744b4ea398d35e3c1bb1bf6a39a5d","generatorHash":"fb11d879369abb4c5c6a89d97c8173cdf4d1aca2fde0aff2e3432df8f89f84da","fixtureHash":"7324b83e1187acbd4861f6a4e0df967a555a9aa819b98e206c720a55a9924e0e","indexing":{"list":{"indices":["int"],"cells":[]},"buckets":{"indices":["i"],"cells":[]},"nums":{"indices":["idx"],"cells":[]}},"examples":[{"name":"Example","input":[[4,3,2,3,5,2,1],4],"expected":true,"result":true,"steps":[{"site":0,"line":2,"lines":[2],"kind":"call","label":"canPartitionKSubsets(self, nums, k)","state":{"self":{"$ref":"o2"},"nums":{"$ref":"o1"},"k":4},"input":{"nums":{"$ref":"o1"},"k":4},"heap":{"o1":{"kind":"array","typeName":"list","items":[4,3,2,3,5,2,1]},"o2":{"kind":"object","typeName":"Solution","fields":{}}},"value":null,"stack":["canPartitionKSubsets(self, nums, k)"]},{"site":1,"line":3,"lines":[3],"kind":"statement","label":"total = sum(nums)","state":{"self":{"$ref":"o2"},"nums":{"$ref":"o1"},"k":4,"total":20},"input":{