{"id":295,"language":"python","title":"Find Median From Data Stream","topic":"Heap / Priority Queue","code":"import heapq\n\nclass MedianFinder:\n    def __init__(self):\n        self.small = []  # max-heap (negate values)\n        self.large = []  # min-heap\n\n    def addNum(self, num: int) -> None:\n        heapq.heappush(self.small, -num)\n\n        # Ensure max of small <= min of large\n        if self.small and self.large and -self.small[0] > self.large[0]:\n            val = -heapq.heappop(self.small)\n            heapq.heappush(self.large, val)\n\n        # Balance sizes\n        if len(self.small) > len(self.large) + 1:\n            val = -heapq.heappop(self.small)\n            heapq.heappush(self.large, val)\n        elif len(self.large) > len(self.small) + 1:\n            val = heapq.heappop(self.large)\n            heapq.heappush(self.small, -val)\n\n    def findMedian(self) -> float:\n        if len(self.small) > len(self.large):\n            return -self.small[0]\n        elif len(self.large) > len(self.small):\n            return self.large[0]\n        else:\n            return (-self.small[0] + self.large[0]) / 2.0","sourceHash":"d788dd2477ea9b72f1e8049af489d1fe0b2d007d5221ccc3c27f4ebec1ab3675","generatorHash":"fb11d879369abb4c5c6a89d97c8173cdf4d1aca2fde0aff2e3432df8f89f84da","fixtureHash":"005220f846fff782dc43a41c84234924deee0ef7201a43e21a9c58e39cae81f2","indexing":{},"examples":[{"name":"Example","input":[],"expected":[null,null,null,1.5,null,2],"result":[null,null,null,1.5,null,2],"steps":[{"site":0,"line":4,"lines":[4],"kind":"call","label":"__init__(self)","state":{"self":{"$ref":"o1"}},"input":{},"heap":{"o1":{"kind":"object","typeName":"MedianFinder","fields":{}}},"value":null,"stack":["__init__(self)"]},{"site":1,"line":5,"lines":[5],"kind":"statement","label":"self.small = []  # max-heap (negate values)","state":{"self":{"$ref":"o1"}},"input":{},"heap":{"o1":{"kind":"object","typeName":"MedianFinder","fields":{"small":{"$ref":"o2"}}},"o2":{"