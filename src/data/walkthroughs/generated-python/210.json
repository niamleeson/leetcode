{"id":210,"language":"python","title":"Course Schedule II","topic":"Graphs","code":"from collections import deque, defaultdict\n\ndef findOrder(numCourses, prerequisites):\n    graph = defaultdict(list)\n    in_degree = [0] * numCourses\n    for course, prereq in prerequisites:\n        graph[prereq].append(course)\n        in_degree[course] += 1\n\n    queue = deque(i for i in range(numCourses) if in_degree[i] == 0)\n    order = []\n    while queue:\n        node = queue.popleft()\n        order.append(node)\n        for neighbor in graph[node]:\n            in_degree[neighbor] -= 1\n            if in_degree[neighbor] == 0:\n                queue.append(neighbor)\n    return order if len(order) == numCourses else []","sourceHash":"13b4b9281392bc35f890ec6a91a74960faf6793e0ff87d95806bb303a37ddfcf","generatorHash":"fb11d879369abb4c5c6a89d97c8173cdf4d1aca2fde0aff2e3432df8f89f84da","fixtureHash":"d74acefd9f03d08b5ba4e46e18b7eec87f050bad286e1979961f00b6b3d0e571","indexing":{"in_degree":{"indices":["course","neighbor","i"],"cells":[]},"graph":{"indices":["node","prereq"],"cells":[]}},"examples":[{"name":"Example","input":[4,[[1,0],[2,0],[3,1],[3,2]]],"expected":[0,2,1,3],"result":[0,1,2,3],"steps":[{"site":0,"line":3,"lines":[3],"kind":"call","label":"findOrder(numCourses, prerequisites)","state":{"numCourses":4,"prerequisites":{"$ref":"o1"}},"input":{"numCourses":4,"prerequisites":{"$ref":"o1"}},"heap":{"o1":{"kind":"array","typeName":"list","items":[{"$ref":"o2"},{"$ref":"o3"},{"$ref":"o4"},{"$ref":"o5"}]},"o2":{"kind":"array","typeName":"list","items":[1,0]},"o3":{"kind":"array","typeName":"list","items":[2,0]},"o4":{"kind":"array","typeName":"list","items":[3,1]},"o5":{"kind":"array","typeName":"list","items":[3,2]}},"value":null,"stack":["findOrder(numCourses, prerequisites)"]},{"site":1,"line":4,"lines":[4],"kind":"statement","label":"graph = defaultdict(list)","state":{"numCourses":4,"prerequisites":{"$ref":"o1"},"graph":{"$ref":"o6"}},"input":{"numCourses":4,"prer