{"id":309,"language":"python","title":"Best Time to Buy And Sell Stock With Cooldown","topic":"2-D Dynamic Programming","code":"class Solution:\n    def maxProfit(self, prices: List[int]) -> int:\n        if not prices:\n            return 0\n\n        hold = -prices[0]  # holding stock\n        sold = 0           # just sold, in cooldown\n        rest = 0           # not holding, free to buy\n\n        for i in range(1, len(prices)):\n            prev_hold = hold\n            prev_sold = sold\n            prev_rest = rest\n\n            hold = max(prev_hold, prev_rest - prices[i])\n            sold = prev_hold + prices[i]\n            rest = max(prev_rest, prev_sold)\n\n        return max(sold, rest)","sourceHash":"a9f12ee925fc2ce550a42a898ea970ef7c07c750352f96754a0b86e19be945e9","generatorHash":"fb11d879369abb4c5c6a89d97c8173cdf4d1aca2fde0aff2e3432df8f89f84da","fixtureHash":"36f642f12f7f0130bd67b500c992c6f59a2100f55bbbb627b1c61d7ec2a7163c","indexing":{"List":{"indices":["int"],"cells":[]},"prices":{"indices":["i"],"cells":[]}},"examples":[{"name":"Example","input":[[1,2,3,0,2]],"expected":3,"result":3,"steps":[{"site":0,"line":2,"lines":[2],"kind":"call","label":"maxProfit(self, prices)","state":{"self":{"$ref":"o2"},"prices":{"$ref":"o1"}},"input":{"prices":{"$ref":"o1"}},"heap":{"o1":{"kind":"array","typeName":"list","items":[1,2,3,0,2]},"o2":{"kind":"object","typeName":"Solution","fields":{}}},"value":null,"stack":["maxProfit(self, prices)"]},{"site":1,"line":3,"lines":[3],"kind":"statement","label":"if not prices:","state":{"self":{"$ref":"o2"},"prices":{"$ref":"o1"}},"input":{"prices":{"$ref":"o1"}},"heap":{},"value":null,"stack":["maxProfit(self, prices)"]},{"site":2,"line":6,"lines":[6],"kind":"statement","label":"hold = -prices[0]  # holding stock","state":{"self":{"$ref":"o2"},"prices":{"$ref":"o1"},"hold":-1},"input":{"prices":{"$ref":"o1"}},"heap":{},"value":null,"stack":["maxProfit(self, prices)"]},{"site":3,"line":7,"lines":[7],"kind":"statement","lab