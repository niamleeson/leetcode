{"id":1137,"language":"python","title":"N-th Tribonacci Number","topic":"1-D Dynamic Programming","code":"class Solution:\n    def tribonacci(self, n: int) -> int:\n        if n == 0:\n            return 0\n        if n <= 2:\n            return 1\n        a, b, c = 0, 1, 1\n        for _ in range(n - 2):\n            a, b, c = b, c, a + b + c\n        return c","sourceHash":"ef27a6eaf4eda84005b302e1fed037ffd4a74b02e2203f26361431a0ef7f02d0","generatorHash":"fb11d879369abb4c5c6a89d97c8173cdf4d1aca2fde0aff2e3432df8f89f84da","fixtureHash":"34561eeb3a141fe8556ffc8178200702bb063b55fc40253a62abe5edd91ff673","indexing":{},"examples":[{"name":"Example","input":[4],"expected":4,"result":4,"steps":[{"site":0,"line":2,"lines":[2],"kind":"call","label":"tribonacci(self, n)","state":{"self":{"$ref":"o1"},"n":4},"input":{"n":4},"heap":{"o1":{"kind":"object","typeName":"Solution","fields":{}}},"value":null,"stack":["tribonacci(self, n)"]},{"site":1,"line":3,"lines":[3],"kind":"statement","label":"if n == 0:","state":{"self":{"$ref":"o1"},"n":4},"input":{"n":4},"heap":{},"value":null,"stack":["tribonacci(self, n)"]},{"site":2,"line":5,"lines":[5],"kind":"statement","label":"if n <= 2:","state":{"self":{"$ref":"o1"},"n":4},"input":{"n":4},"heap":{},"value":null,"stack":["tribonacci(self, n)"]},{"site":3,"line":7,"lines":[7],"kind":"statement","label":"a, b, c = 0, 1, 1","state":{"self":{"$ref":"o1"},"n":4,"a":0,"b":1,"c":1},"input":{"n":4},"heap":{},"value":null,"stack":["tribonacci(self, n)"]},{"site":4,"line":8,"lines":[8],"kind":"statement","label":"for _ in range(n - 2):","state":{"self":{"$ref":"o1"},"n":4,"a":0,"b":1,"c":1,"_":0},"input":{"n":4},"heap":{},"value":null,"stack":["tribonacci(self, n)"]},{"site":5,"line":9,"lines":[9],"kind":"statement","label":"a, b, c = b, c, a + b + c","state":{"self":{"$ref":"o1"},"n":4,"a":1,"b":1,"c":2,"_":0},"input":{"n":4},"heap":{},"value":null,"stack":["tribonacci(self, n)"]},{"site":4,"line":8,"lines":[8],"kind":"statement","label":"for