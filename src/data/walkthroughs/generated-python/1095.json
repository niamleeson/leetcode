{"id":1095,"language":"python","title":"Find in Mountain Array","topic":"Binary Search","code":"class Solution:\n    def findInMountainArray(self, target: int, mountain_arr) -> int:\n        n = mountain_arr.length()\n        lo, hi = 0, n - 1\n        while lo < hi:\n            mid = (lo + hi) // 2\n            if mountain_arr.get(mid) < mountain_arr.get(mid + 1):\n                lo = mid + 1\n            else:\n                hi = mid\n        peak = lo\n        lo, hi = 0, peak\n        while lo <= hi:\n            mid = (lo + hi) // 2\n            val = mountain_arr.get(mid)\n            if val == target:\n                return mid\n            elif val < target:\n                lo = mid + 1\n            else:\n                hi = mid - 1\n        lo, hi = peak + 1, n - 1\n        while lo <= hi:\n            mid = (lo + hi) // 2\n            val = mountain_arr.get(mid)\n            if val == target:\n                return mid\n            elif val < target:\n                hi = mid - 1\n            else:\n                lo = mid + 1\n        return -1","sourceHash":"3915baf21507fcc90e5a84f3eca521ddfb2120d19426f2a5b4b15bcb7ff7a416","generatorHash":"fb11d879369abb4c5c6a89d97c8173cdf4d1aca2fde0aff2e3432df8f89f84da","fixtureHash":"d376fcd725340470074ad2da057590c29f68b2ae02e7845977ac131ff2898b36","indexing":{},"examples":[{"name":"Example","input":[3,{"$mountain":[1,2,3,4,5,3,1]}],"expected":2,"result":2,"steps":[{"site":0,"line":2,"lines":[2],"kind":"call","label":"findInMountainArray(self, target, mountain_arr)","state":{"self":{"$ref":"o3"},"target":3,"mountain_arr":{"$ref":"o1"}},"input":{"target":3,"mountain_arr":{"$ref":"o1"}},"heap":{"o1":{"kind":"object","typeName":"MountainArray","fields":{"values":{"$ref":"o2"}}},"o2":{"kind":"array","typeName":"list","items":[1,2,3,4,5,3,1]},"o3":{"kind":"object","typeName":"Solution","fields":{}}},"value":null,"stack":["findInMountainArray(self, target, mountain_arr)"]},{"site":1,"line":3,"lines":[3],"kind":"sta